---
/**
 * VISTA: LISTADO DE ESCUELAS (/escuelas/)
 * ----------------------------------------------------------------------------
 * Cada escuela como una tarjeta horizontal grande: foto, sigla, nombre
 * completo, datos clave (duración y fechas) y enlace a su página.
 * Las tarjetas alternan la foto a izquierda y derecha en escritorio.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import PendingContent from '@/components/PendingContent.astro';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import Motif from '@/components/ui/Motif.astro';
import SmartImage from '@/components/ui/SmartImage.astro';
import { routes, schoolAlternates, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { getPageTexts, getSchools, getSiteSettings } from '@/lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const [schools, texts, settings] = await Promise.all([getSchools(locale), getPageTexts(locale), getSiteSettings(locale)]);
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  locale={locale}
  alternates={routes.schools}
  title={ui.nav.schools}
  description={texts.schoolsIntro ?? undefined}
  headerOverlay
>
  <PageHero title={ui.nav.schools} eyebrow={settings.organizationName} lead={texts.schoolsIntro} motif="path" />

  <section class="section" aria-labelledby="schools-list-title">
    <div class="container">
      <h2 class="visually-hidden" id="schools-list-title">{ui.lists.schoolsTitle}</h2>
      <ul role="list" class="school-list">
        {
          schools.map((s, i) => (
            <li data-reveal>
              <a class="school-card" href={schoolAlternates(s.slug)[locale]} data-event="program_card_click">
                <div class="school-card__media">
                  {s.image ? (
                    <SmartImage image={s.image} decorative sizes="(min-width: 64rem) 40vw, 100vw" widths={[480, 768, 1080]} />
                  ) : (
                    <ImagePlaceholder label={pad(i + 1)} />
                  )}
                </div>
                <div class="school-card__body">
                  <div class="school-card__top">
                    <span class="school-card__num">{pad(i + 1)}</span>
                    {s.motif && (
                      <span class="school-card__motif">
                        <Motif name={s.motif} />
                      </span>
                    )}
                  </div>
                  <h3 class="school-card__name">{s.name}</h3>
                  {s.fullName && <p class="school-card__full">{s.fullName}</p>}
                  {s.description && <p class="school-card__desc">{s.description}</p>}
                  <dl class="school-card__facts">
                    <div>
                      <dt>{ui.detail.duration}</dt>
                      <dd>{s.duration ?? <PendingContent locale={locale} />}</dd>
                    </div>
                    <div>
                      <dt>{ui.detail.dates}</dt>
                      <dd>{s.dates ?? <PendingContent locale={locale} />}</dd>
                    </div>
                  </dl>
                  <span class="link-arrow school-card__more">
                    {ui.lists.viewSchool} <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .school-list {
    display: grid;
    gap: var(--space-6);
  }

  .school-card {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    color: var(--color-night);
    text-decoration: none;
    transition:
      box-shadow 400ms var(--ease),
      transform 400ms var(--ease);
  }

  .school-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  @media (min-width: 64rem) {
    .school-card {
      grid-template-columns: 1fr 1.2fr;
    }

    .school-list li:nth-child(even) .school-card__media {
      order: 2;
    }
  }

  .school-card__media {
    min-height: 16rem;
    overflow: hidden;
  }

  .school-card__media :global(img),
  .school-card__media :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease);
  }

  .school-card:hover .school-card__media :global(img) {
    transform: scale(1.05);
  }

  .school-card__body {
    display: grid;
    gap: var(--space-3);
    align-content: center;
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
  }

  .school-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .school-card__num {
    color: var(--color-green);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .school-card__motif {
    width: 6rem;
  }

  /* En fondo claro, el motivo va en verde (el azul no tiene contraste). */
  .school-card__motif :global(.motif) {
    color: var(--color-green);
  }

  .school-card__name {
    font-size: clamp(3rem, 2rem + 4vw, 6rem);
    line-height: 0.9;
  }

  .school-card__full {
    font-size: var(--text-xl);
    font-weight: 600;
  }

  .school-card__desc {
    color: var(--color-text-muted);
  }

  .school-card__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .school-card__facts dt {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .school-card__facts dd {
    margin: var(--space-1) 0 0;
  }

  .school-card__more {
    margin-top: var(--space-3);
    color: var(--color-green);
  }
</style>
