---
/**
 * VISTA: CONTACTO (especificación §16)
 * ----------------------------------------------------------------------------
 * Portada + formulario de contacto (ContactForm.astro) + canales directos
 * (WhatsApp, correo, teléfonos) + ubicación y redes sociales.
 * Si se llega con ?motivo=come, el formulario trae el motivo preseleccionado.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactChannels from '@/components/ContactChannels.astro';
import ContactForm from '@/components/ContactForm.astro';
import PageHero from '@/components/PageHero.astro';
import PendingContent from '@/components/PendingContent.astro';
import { routes, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { getPageTexts, getSiteSettings, type SocialLinks } from '@/lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const [settings, texts] = await Promise.all([getSiteSettings(locale), getPageTexts(locale)]);

const socialNames: Record<keyof SocialLinks, string> = {
  instagram: 'Instagram',
  facebook: 'Facebook',
  youtube: 'YouTube',
  tiktok: 'TikTok',
};
const socials = (Object.keys(socialNames) as (keyof SocialLinks)[])
  .filter((k) => settings.social[k])
  .map((k) => ({ name: socialNames[k], href: settings.social[k]! }));
---

<BaseLayout
  locale={locale}
  alternates={routes.contact}
  title={ui.nav.contact}
  description={texts.contactIntro ?? undefined}
  headerOverlay
>
  <PageHero title={ui.home.contactTitle} eyebrow={ui.nav.contact} lead={texts.contactIntro} motif="river" />

  <section class="section">
    <div class="container contact-layout">
      <div class="contact-layout__form" data-reveal>
        <ContactForm locale={locale} organizationName={settings.organizationName} />
      </div>

      <aside class="contact-layout__aside" aria-label={ui.home.contactEyebrow}>
        <ContactChannels locale={locale} settings={settings} />

        <div class="contact-extra">
          <h2 class="eyebrow eyebrow--line contact-extra__label">{ui.contact.location}</h2>
          {settings.location ? <p class="contact-extra__value">{settings.location}</p> : <PendingContent locale={locale} />}
        </div>

        <div class="contact-extra">
          <h2 class="eyebrow eyebrow--line contact-extra__label">{ui.footer.social}</h2>
          {
            socials.length > 0 ? (
              <ul role="list" class="contact-extra__social">
                {socials.map((s) => (
                  <li>
                    <a href={s.href} target="_blank" rel="noopener" data-event="social_click">
                      {s.name} ↗
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <PendingContent locale={locale} />
            )
          }
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-layout {
    display: grid;
    gap: var(--space-8);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .contact-layout {
      grid-template-columns: 1.4fr 1fr;
    }

    .contact-layout__aside {
      position: sticky;
      top: calc(var(--header-height) + var(--space-5));
    }
  }

  .contact-layout__aside {
    display: grid;
    gap: var(--space-7);
  }

  .contact-extra__label {
    display: flex;
    margin-bottom: var(--space-3);
    color: var(--color-green);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    line-height: 1.4;
  }

  .contact-extra__value {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    text-transform: uppercase;
  }

  .contact-extra__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .contact-extra__social a {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--color-night);
    text-decoration: none;
  }
</style>
