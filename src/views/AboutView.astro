---
/**
 * VISTA: QUIÉNES SOMOS (especificación §7)
 * ----------------------------------------------------------------------------
 * Portada · introducción · misión y visión · valores · historia · equipo.
 * Todo viene del documento "Quiénes somos" y de "Personas" en el panel.
 * Lo no confirmado por JUCUM se muestra como "Pendiente de contenido".
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Founders from '@/components/Founders.astro';
import PageHero from '@/components/PageHero.astro';
import PendingContent from '@/components/PendingContent.astro';
import PersonCard from '@/components/PersonCard.astro';
import Timeline from '@/components/features/Timeline.astro';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import { routes, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { showPending } from '@/lib/config';
import { valueGroups } from '@/lib/content/types';
import { getAbout, getPeople, getSiteSettings, ogImageUrl } from '@/lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const [about, people, settings] = await Promise.all([getAbout(locale), getPeople(locale), getSiteSettings(locale)]);

// La historia se dibuja con el mismo componente de "Etapas".
// Valores: se conserva el número oficial (1 a 18) y se agrupan en cuatro grupos.
const numbered = about.values.map((v, i) => ({ ...v, n: i + 1 }));
const ungrouped = numbered.filter((v) => !v.group);
const groupIcons: Record<(typeof valueGroups)[number], string> = {
  god: 'M4 5c3-1 6-1 8 1 2-2 5-2 8-1v13c-3-1-6-1-8 1-2-2-5-2-8-1zM12 6v13',
  world: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18',
  people: 'M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z',
  work: 'M9 12a3 3 0 1 0 0-.01M15 12a3 3 0 1 0 0-.01M5 19c1-3 3-4 4-4M19 19c-1-3-3-4-4-4M12 15c-1.5 0-3 1-3.5 4h7C15 16 13.5 15 12 15z',
};

const historyBlock = {
  type: 'timeline' as const,
  title: ui.about.history,
  intro: null,
  steps: about.history.map((h) => ({ label: h.year, title: h.title, text: h.text })),
};
---

<BaseLayout
  locale={locale}
  alternates={routes.about}
  title={ui.nav.about}
  description={about.intro}
  ogImage={ogImageUrl(about.image)}
  preloadImage={about.image}
  headerOverlay
>
  <PageHero title={ui.nav.about} eyebrow={settings.organizationName} image={about.image} />

  <!-- Introducción -->
  <section class="section">
    <div class="container">
      <p class="about-intro" data-reveal>{about.intro}</p>
    </div>
  </section>

  <!-- Parte del movimiento global JUCUM -->
  {
    about.global && (
      <section class="section surface-sand" aria-labelledby="global-title">
        <div class="container container--narrow">
          <p class="eyebrow eyebrow--line" data-reveal>{ui.about.globalEyebrow}</p>
          <h2 id="global-title" class="visually-hidden">{ui.about.globalEyebrow}</h2>
          <p class="lead" data-reveal>{about.global}</p>
        </div>
      </section>
    )
  }

  <!-- Misión y visión -->
  <section class="section surface-dark" aria-labelledby="identity-title">
    <div class="container">
      <h2 class="visually-hidden" id="identity-title">{ui.about.mission} · {ui.about.vision}</h2>
      <div class="identity">
        <div class="identity__item" data-reveal>
          <p class="eyebrow eyebrow--line identity__label">{ui.about.mission}</p>
          {about.mission ? <p class="identity__text">{about.mission}</p> : <PendingContent locale={locale} />}
        </div>
        <div class="identity__item" data-reveal style="--reveal-delay: 120ms">
          <p class="eyebrow eyebrow--line identity__label">{ui.about.vision}</p>
          {about.vision ? <p class="identity__text">{about.vision}</p> : <PendingContent locale={locale} />}
        </div>
      </div>

      {
        (about.motto || about.verse) && (
          <div class="identity__extra">
            {about.motto && (
              <div data-reveal>
                <p class="eyebrow eyebrow--line identity__label">{ui.about.motto}</p>
                <p class="identity__motto">{about.motto}</p>
              </div>
            )}
            {about.verse && (
              <figure data-reveal style="--reveal-delay: 120ms">
                <p class="eyebrow eyebrow--line identity__label">{ui.about.verse}</p>
                <blockquote class="identity__verse">“{about.verse.text}”</blockquote>
                <figcaption class="identity__ref">{about.verse.reference}</figcaption>
              </figure>
            )}
          </div>
        )
      }
    </div>
  </section>

  <!-- Valores -->
  <section class="section" aria-labelledby="values-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow eyebrow--line">{ui.about.eyebrow}</p>
        <h2 id="values-title">{ui.about.values}</h2>
      </div>
      {
        about.values.length > 0 ? (
          <>
            <p class="values-hint" data-reveal>{ui.about.valuesHint}</p>
            <div class="vgroups">
              {valueGroups.map((g, gi) => (
                <section class="vgroup" data-reveal style={`--reveal-delay: ${gi * 90}ms`} aria-labelledby={`vg-${g}`}>
                  <svg class="vgroup__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={groupIcons[g]} /></svg>
                  <h3 id={`vg-${g}`} class="vgroup__title">{ui.about.valueGroups[g]}</h3>
                  <div class="vgroup__list">
                    {numbered
                      .filter((v) => v.group === g)
                      .map((v) => (
                        <details class="value">
                          <summary>
                            <span class="value__n">{String(v.n).padStart(2, '0')}</span>
                            <span class="value__t">{v.title}</span>
                          </summary>
                          {v.text && <p>{v.text}</p>}
                        </details>
                      ))}
                  </div>
                </section>
              ))}
            </div>
            {ungrouped.length > 0 && (
              <ol class="values">
                {ungrouped.map((v) => (
                  <li>
                    <span class="values__num">{String(v.n).padStart(2, '0')}</span>
                    <h3>{v.title}</h3>
                    {v.text && <p>{v.text}</p>}
                  </li>
                ))}
              </ol>
            )}
          </>
        ) : (
          <PendingContent locale={locale} />
        )
      }
    </div>
  </section>

  <!-- Historia -->
  <!-- Los dos directores fundadores (esposos), destacados antes de la historia. -->
  <Founders locale={locale} founders={about.founders} />

  <section class="section surface-sand" aria-labelledby="history-title">
    <div class="container">
      {
        about.history.length > 0 || showPending ? (
          <Timeline locale={locale} block={historyBlock} titleId="history-title" pendingText={ui.about.historyPending} />
        ) : (
          <h2 id="history-title" class="visually-hidden">
            {ui.about.history}
          </h2>
        )
      }
    </div>
  </section>

  <!-- Equipo -->
  <section class="section" aria-labelledby="team-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow eyebrow--line">{ui.about.team}</p>
        <h2 id="team-title">{ui.about.teamTitle}</h2>
        {about.teamIntro && <p class="lead team-intro">{about.teamIntro}</p>}
        <a class="link-arrow team-link" href={routes.people[locale]}>{ui.people.allTeam} <span aria-hidden="true">→</span></a>
      </div>
      {
        people.length > 0 ? (
          <ul role="list" class="team">
            {people.map((p, i) => (
              <li data-reveal style={`--reveal-delay: ${(i % 4) * 80}ms`}>
                <PersonCard locale={locale} person={p} />
              </li>
            ))}
          </ul>
        ) : (
          showPending && (
            <ul role="list" class="team">
              {[1, 2, 3, 4].map(() => (
                <li class="team__ghost" aria-hidden="true">
                  <ImagePlaceholder />
                </li>
              ))}
              <li class="team__pending">
                <PendingContent locale={locale} />
              </li>
            </ul>
          )
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .identity__extra {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-8);
    padding-top: var(--space-7);
    border-top: 1px solid var(--color-border-on-dark);
  }

  @media (min-width: 64rem) {
    .identity__extra {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  .identity__motto {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.05;
    text-transform: uppercase;
  }

  .identity__verse {
    font-size: var(--text-lg, 1.25rem);
    line-height: 1.5;
  }

  .identity__ref {
    margin-top: var(--space-3);
    color: var(--color-river);
    font-weight: 700;
  }

  .about-intro {
    max-width: 60rem;
    font-family: var(--font-display);
    font-size: var(--text-statement);
    line-height: 1.02;
    text-transform: uppercase;
  }

  .identity {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 64rem) {
    .identity {
      grid-template-columns: 1fr 1fr;
    }
  }

  .identity__item {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .identity__label {
    color: var(--color-river);
  }

  .identity__text {
    font-size: var(--text-2xl);
    line-height: 1.35;
  }

  /* ---------- Valores en cuatro grupos ---------- */
  .values-hint {
    margin-bottom: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .vgroups {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 48rem) {
    .vgroups {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 80rem) {
    .vgroups {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .vgroup {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    box-shadow: var(--shadow);
    border-top: 5px solid var(--color-green);
  }

  .vgroup__icon {
    width: 2.6rem;
    height: 2.6rem;
    fill: none;
    stroke: var(--color-green);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .vgroup__title {
    font-size: var(--text-h3);
    line-height: 1;
    text-transform: uppercase;
  }

  .vgroup__list {
    display: grid;
  }

  .value {
    border-top: 1px solid var(--color-border);
  }

  .value summary {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .value summary::-webkit-details-marker {
    display: none;
  }

  .value summary::after {
    content: '+';
    margin-left: auto;
    color: var(--color-green);
    font-size: 1.4rem;
    line-height: 1;
    transition: transform var(--duration) var(--ease);
  }

  .value[open] summary::after {
    transform: rotate(45deg);
  }

  .value summary:hover .value__t {
    color: var(--color-green);
  }

  .value__n {
    color: var(--color-green);
    font-size: var(--text-xs);
  }

  .value p {
    padding-bottom: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .values {
    display: grid;
    gap: var(--space-6);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .values {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
  }

  .values li {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding-top: var(--space-5);
    border-top: 2px solid var(--color-night);
  }

  .values__num {
    color: var(--color-green);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .values p {
    color: var(--color-text-muted);
  }

  .team-link {
    color: var(--color-green);
  }

  .team-intro {
    max-width: 40rem;
    color: var(--color-text-muted);
  }

  .team {
    display: grid;
    gap: var(--space-7) var(--space-5);
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }

  .team__ghost {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    opacity: 0.6;
  }

  .team__pending {
    grid-column: 1 / -1;
  }
</style>
