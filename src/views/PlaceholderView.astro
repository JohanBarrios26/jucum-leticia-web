---
/**
 * VISTA TEMPORAL: PÁGINA EN CONSTRUCCIÓN
 * ----------------------------------------------------------------------------
 * La usan las páginas que todavía no tienen su diseño propio (Quiénes somos,
 * listados de Ministerios y Escuelas, Sé parte, Contacto). Cuando se construya
 * cada una, se crea su vista en src/views/ y se cambia el archivo de src/pages/.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import PendingContent from '@/components/PendingContent.astro';
import { routes, type Locale, type RouteKey } from '@/i18n/routes';
import { t } from '@/i18n/ui';

interface Props {
  locale: Locale;
  /** Clave de la página en el mapa de rutas (ej. 'about'). */
  page: Exclude<RouteKey, 'home'>;
}

const { locale, page } = Astro.props;
const ui = t(locale);
---

<BaseLayout locale={locale} alternates={routes[page]} title={ui.nav[page]}>
  <PageHeader title={ui.nav[page]} />
  <section class="section">
    <div class="container container--narrow">
      <p>{ui.underConstruction}</p>
      <p class="pending-row"><PendingContent locale={locale} /></p>
    </div>
  </section>
</BaseLayout>

<style>
  .pending-row {
    margin-top: var(--space-4);
  }
</style>
