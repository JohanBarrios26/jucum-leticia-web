---
/**
 * VISTA: SÉ PARTE (especificación §15)
 * ----------------------------------------------------------------------------
 * Los cuatro caminos (Orar · Servir · Venir · Apoyar), cada uno en su sección
 * con ancla (#orando, #sirviendo…), a las que enlazan el inicio y el pie.
 *
 * Cada sección: número, título, explicación, "Información" (preguntas con
 * respuesta o "pendiente") y un botón de WhatsApp con el mensaje ya escrito.
 * En escritorio, un menú lateral fijo marca el camino que se está leyendo.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import PendingContent from '@/components/PendingContent.astro';
import { joinAnchorId, routes, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { getJoinPaths, getPageTexts, getSiteSettings, whatsappUrl } from '@/lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const [paths, texts, settings] = await Promise.all([getJoinPaths(locale), getPageTexts(locale), getSiteSettings(locale)]);

const eventName = { pray: 'cta_pray_click', serve: 'cta_serve_click', come: 'cta_come_click', support: 'cta_support_click' };
---

<BaseLayout locale={locale} alternates={routes.join} title={ui.nav.join} description={texts.joinIntro ?? undefined} headerOverlay>
  <PageHero title={ui.nav.join} eyebrow={settings.organizationName} lead={texts.joinIntro} motif="path" />

  <div class="container join-layout">
    <!-- Menú lateral (escritorio) / índice horizontal (móvil) -->
    <nav class="join-nav" aria-label={ui.join.pathsNav}>
      <ol>
        {
          paths.map((p, i) => (
            <li>
              <a href={`#${joinAnchorId(p.key, locale)}`} data-join-link={joinAnchorId(p.key, locale)}>
                <span>0{i + 1}</span> {p.title}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="join-paths">
      {
        paths.map((p, i) => (
          <section class="join-path" id={joinAnchorId(p.key, locale)} aria-labelledby={`${p.key}-title`} data-join-section>
            <span class="join-path__num" aria-hidden="true">
              0{i + 1}
            </span>
            <h2 id={`${p.key}-title`} data-reveal>
              {p.title}
            </h2>
            <p class="lead join-path__text" data-reveal>
              {p.body ?? p.text}
            </p>

            {p.details.length > 0 && (
              <div class="join-path__info" data-reveal>
                <h3 class="join-path__info-title">{ui.join.info}</h3>
                <dl>
                  {p.details.map((d) => (
                    <div class="join-path__row">
                      <dt>{d.label}</dt>
                      <dd>{d.value ?? <PendingContent locale={locale} />}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            )}

            {settings.whatsapp && (
              <a
                class="btn btn--primary join-path__cta"
                href={whatsappUrl(settings.whatsapp, p.whatsappMessage ?? ui.contact.whatsappMessage)}
                target="_blank"
                rel="noopener"
                data-event={eventName[p.key]}
              >
                {ui.join.cta} <span class="btn__arrow" aria-hidden="true">→</span>
              </a>
            )}
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<script>
  // Marca en el menú lateral el camino que está en pantalla.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-join-link]');
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((a) => a.toggleAttribute('aria-current', a.dataset.joinLink === entry.target.id));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  document.querySelectorAll('[data-join-section]').forEach((s) => observer.observe(s));
</script>

<style>
  .join-layout {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-7) var(--space-section);
  }

  /* Evita que el índice horizontal (móvil) ensanche la columna y corte el texto. */
  .join-layout > * {
    min-width: 0;
  }

  @media (min-width: 64rem) {
    .join-layout {
      grid-template-columns: 14rem 1fr;
      gap: var(--space-9);
    }
  }

  /* ---------- Menú ---------- */
  .join-nav ol {
    display: flex;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
    overflow-x: auto;
  }

  .join-nav a {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-night);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .join-nav a span {
    color: var(--color-green);
    font-size: var(--text-xs);
  }

  .join-nav a[aria-current] {
    background: var(--color-night);
    border-color: var(--color-night);
    color: var(--color-cloud);
  }

  .join-nav a[aria-current] span {
    color: var(--color-river);
  }

  @media (min-width: 64rem) {
    .join-nav {
      position: sticky;
      top: calc(var(--header-height) + var(--space-6));
      align-self: start;
    }

    .join-nav ol {
      flex-direction: column;
      overflow: visible;
    }

    .join-nav a {
      border-color: transparent;
      border-radius: var(--radius-sm);
      font-family: var(--font-display);
      font-size: 1.75rem;
      font-weight: 400;
      text-transform: uppercase;
    }
  }

  /* ---------- Cada camino ---------- */
  .join-paths {
    display: grid;
  }

  .join-path {
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .join-path:first-child {
    border-top: 0;
    padding-top: var(--space-4);
  }

  .join-path__num {
    position: absolute;
    top: var(--space-6);
    right: 0;
    font-family: var(--font-display);
    font-size: clamp(5rem, 3rem + 8vw, 11rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgb(16 42 42 / 0.15);
    pointer-events: none;
  }

  .join-path h2 {
    font-size: var(--text-h1);
  }

  .join-path__text {
    max-width: 40rem;
    color: var(--color-text-muted);
  }

  .join-path__info {
    max-width: 48rem;
  }

  .join-path__info-title {
    margin-bottom: var(--space-3);
    color: var(--color-green);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    line-height: 1.4;
  }

  .join-path__row {
    display: grid;
    gap: var(--space-1) var(--space-5);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 40rem) {
    .join-path__row {
      grid-template-columns: 14rem 1fr;
    }
  }

  .join-path__row dt {
    font-weight: 700;
  }

  .join-path__row dd {
    margin: 0;
    color: var(--color-text-muted);
  }

  .join-path__cta {
    justify-self: start;
  }
</style>
