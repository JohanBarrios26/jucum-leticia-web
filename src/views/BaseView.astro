---
/**
 * VISTA: PÁGINA DE UNA BASE (/bases/[slug]/)
 * ----------------------------------------------------------------------------
 * Portada (foto + motivo) → descripción y qué se realiza aquí (enlaces a las
 * escuelas/ministerios) → Cómo llegar (ilustración de rutas) → fotos y videos
 * → invitación a visitarla (WhatsApp con mensaje ya escrito).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import BaseAccess from '@/components/BaseAccess.astro';
import PageHero from '@/components/PageHero.astro';
import PendingContent from '@/components/PendingContent.astro';
import LiteVideo from '@/components/features/LiteVideo.astro';
import SmartImage from '@/components/ui/SmartImage.astro';
import { baseAlternates, ministryAlternates, routes, schoolAlternates, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { showPending } from '@/lib/config';
import { getSiteSettings, ogImageUrl, whatsappUrl, type Base } from '@/lib/content';

interface Props {
  locale: Locale;
  base: Base;
}

const { locale, base } = Astro.props;
const ui = t(locale);
const settings = await getSiteSettings(locale);
const visitHref = settings.whatsapp
  ? whatsappUrl(settings.whatsapp, `${ui.bases.visitMessage} ${base.name}.`)
  : routes.contact[locale];
const hasMedia = base.gallery.length > 0 || base.videos.length > 0;
---

<BaseLayout
  locale={locale}
  alternates={baseAlternates(base.slug)}
  title={base.name}
  description={base.description ?? base.tagline ?? undefined}
  ogImage={ogImageUrl(base.image)}
  breadcrumbs={[
    { name: ui.nav.home, url: routes.home[locale] },
    { name: ui.nav.bases, url: routes.bases[locale] },
    { name: base.name, url: baseAlternates(base.slug)[locale] },
  ]}
  pageEvent="base_view"
  pageItem={base.slug}
  headerOverlay
>
  <PageHero
    title={base.name}
    eyebrow={base.tagline ?? undefined}
    lead={base.location}
    image={base.image}
    motif={base.motif}
    back={{ href: routes.bases[locale], label: ui.nav.bases }}
  />

  <!-- Descripción + qué se realiza aquí -->
  <section class="section">
    <div class="container base-intro">
      <div data-reveal>
        <h2 class="eyebrow eyebrow--line base-label">{ui.detail.about}</h2>
        {base.description ? <p class="lead">{base.description}</p> : <PendingContent locale={locale} />}
      </div>

      <div data-reveal style="--reveal-delay: 100ms">
        <h2 class="eyebrow eyebrow--line base-label">{ui.bases.programs}</h2>
        {
          base.programs.length > 0 ? (
            <ul role="list" class="programs">
              {base.programs.map((p) => (
                <li>
                  <a
                    class="program"
                    href={p.kind === 'school' ? schoolAlternates(p.slug)[locale] : ministryAlternates(p.slug)[locale]}
                  >
                    <span class="program__kind">{p.kind === 'school' ? ui.bases.school : ui.bases.ministry}</span>
                    <span class="program__name">{p.name}</span>
                    <span class="program__arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <PendingContent locale={locale} />
          )
        }
      </div>
    </div>
  </section>

  <!-- Cómo llegar -->
  {
    base.accessRoutes.length > 0 && (
      <section class="section surface-sand" aria-labelledby="access-title">
        <div class="container">
          <BaseAccess locale={locale} base={base} titleId="access-title" />
        </div>
      </section>
    )
  }

  <!-- Fotos y videos -->
  {
    (hasMedia || showPending) && (
      <section class="section surface-dark" aria-labelledby="media-title">
        <div class="container">
          <h2 id="media-title" class="media-title" data-reveal>
            {ui.bases.photos} · {ui.bases.videos}
          </h2>

          {base.gallery.length > 0 && (
            <ul role="list" class="photos">
              {base.gallery.map((img, i) => (
                <li data-reveal="scale" style={`--reveal-delay: ${(i % 3) * 80}ms`}>
                  <SmartImage image={img} sizes="(min-width: 64rem) 30vw, 90vw" widths={[480, 768, 1080]} />
                </li>
              ))}
            </ul>
          )}

          {base.videos.length > 0 && (
            <div class="videos">
              {base.videos.map((v, i) => (
                <LiteVideo
                  locale={locale}
                  block={{ type: 'video', title: v.title, url: v.url, youtubeId: v.youtubeId }}
                  titleId={`base-video-${i}`}
                />
              ))}
            </div>
          )}

          {!hasMedia && (
            <p class="media-pending">
              {ui.bases.mediaPending} <PendingContent locale={locale} />
            </p>
          )}
        </div>
      </section>
    )
  }

  <!-- Invitación a visitarla -->
  <section class="section">
    <div class="container visit" data-reveal>
      <div>
        <h2 class="visit__title">{ui.bases.visit}</h2>
        <p class="visit__text">{ui.bases.visitText}</p>
      </div>
      <a class="btn btn--primary" href={visitHref} target="_blank" rel="noopener" data-event="whatsapp_click">
        {ui.contact.writeWhatsapp} <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .base-intro {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 64rem) {
    .base-intro {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .base-label {
    display: flex;
    margin-bottom: var(--space-5);
    color: var(--color-green);
  }

  /* Programas que se realizan en la base */
  .programs {
    display: grid;
    gap: var(--space-3);
  }

  .program {
    position: relative;
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-8) var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-white);
    color: var(--color-night);
    text-decoration: none;
    transition:
      border-color var(--duration) var(--ease),
      transform 400ms var(--ease);
  }

  .program:hover {
    border-color: var(--color-green);
    transform: translateX(4px);
  }

  .program__kind {
    color: var(--color-green);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .program__name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1;
    text-transform: uppercase;
  }

  .program__arrow {
    position: absolute;
    top: 50%;
    right: var(--space-5);
    transform: translateY(-50%);
  }

  /* Fotos y videos */
  .media-title {
    margin-bottom: var(--space-6);
  }

  .photos {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  }

  .photos li {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .photos :global(img),
  .photos :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .videos {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-7);
  }

  @media (min-width: 64rem) {
    .videos {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .videos :global(.video__title) {
    font-size: var(--text-h3);
  }

  .media-pending {
    color: var(--color-text-on-dark-muted);
  }

  /* Invitación */
  .visit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: var(--color-sand);
  }

  .visit__title {
    font-size: var(--text-h3);
  }

  .visit__text {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }
</style>
