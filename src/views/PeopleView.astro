---
/**
 * VISTA: NUESTRO EQUIPO (/personas/)
 * ----------------------------------------------------------------------------
 * Todas las personas que sirven en JUCUM Leticia y autorizaron publicar sus
 * datos, en el orden del panel. Cada tarjeta lleva a su perfil, donde se puede
 * orar por ella y apoyarla personalmente.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import Founders from '@/components/Founders.astro';
import PageHero from '@/components/PageHero.astro';
import PendingContent from '@/components/PendingContent.astro';
import PersonCard from '@/components/PersonCard.astro';
import Icon from '@/components/ui/Icon.astro';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import { routes, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { showPending } from '@/lib/config';
import { getAbout, getPageImages, getPageTexts, getPeople, getSiteSettings } from '@/lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const [people, texts, settings, about] = await Promise.all([
  getPeople(locale),
  getPageTexts(locale),
  getSiteSettings(locale),
  getAbout(locale),
]);
const images = await getPageImages(locale);

// La descripción del equipo va debajo de la portada (para no tapar la foto):
// las frases de apertura como texto y, si termina en pregunta, esa pregunta destacada.
const intro = (texts.peopleIntro ?? '').trim();
const sentences = intro.split(/(?<=[.!?])\s+/).filter(Boolean);
const hasQuestion = sentences.length > 1 && sentences[sentences.length - 1].endsWith('?');
const introQuestion = hasQuestion ? sentences[sentences.length - 1] : null;
const introBody = (hasQuestion ? sentences.slice(0, -1) : sentences).join(' ');
---

<BaseLayout
  locale={locale}
  alternates={routes.people}
  title={ui.nav.people}
  description={texts.peopleIntro ?? undefined}
  headerOverlay
>
  <PageHero title={ui.nav.people} eyebrow={settings.organizationName} image={images.people} motif="crown" />

  {
    intro && (
      <section class="section team-intro" aria-label={ui.nav.people}>
        <div class="container">
          <div class="team-intro__card" data-reveal>
            <span class="team-intro__icon" aria-hidden="true">
              <Icon name="heart" />
            </span>
            <div class="team-intro__text">
              <p class="team-intro__body">{introBody}</p>
              {introQuestion && <p class="team-intro__question">{introQuestion}</p>}
              <a class="btn btn--primary team-intro__cta" href="#familias">
                {ui.people.meetFamilies} <span class="btn__arrow" aria-hidden="true">↓</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Los directores fundadores van primero. -->
  <Founders locale={locale} founders={about.founders} />

  <section class="section" id="familias" aria-labelledby="people-title">
    <div class="container">
      <h2 class="visually-hidden" id="people-title">{ui.nav.people}</h2>
      {
        people.length > 0 ? (
          <ul role="list" class="people-grid">
            {people.map((p, i) => (
              <li data-reveal style={`--reveal-delay: ${(i % 4) * 80}ms`}>
                <PersonCard locale={locale} person={p} />
              </li>
            ))}
          </ul>
        ) : (
          showPending && (
            <>
              <p class="people-pending">
                {ui.people.pendingTeam} <PendingContent locale={locale} />
              </p>
              <ul role="list" class="people-grid" aria-hidden="true">
                {[1, 2, 3, 4].map(() => (
                  <li class="people-ghost">
                    <ImagePlaceholder />
                  </li>
                ))}
              </ul>
            </>
          )
        )
      }
    </div>
  </section>

  <CtaBand locale={locale} motif="crown" />
</BaseLayout>

<style>
  /* Descripción del equipo: tarjeta oscura con el corazón, el texto grande y la pregunta destacada. */
  .team-intro {
    padding-bottom: 0;
  }

  .team-intro__card {
    display: grid;
    gap: var(--space-5);
    align-items: start;
    padding: clamp(1.75rem, 1rem + 3vw, 3.5rem);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(ellipse at 100% 0%, rgb(31 111 91 / 0.6), transparent 60%),
      radial-gradient(ellipse at 0% 100%, rgb(0 173 239 / 0.14), transparent 55%),
      var(--color-night);
    color: var(--color-text-on-dark);
    box-shadow: var(--shadow-lg);
  }

  @media (min-width: 48rem) {
    .team-intro__card {
      grid-template-columns: auto 1fr;
      gap: var(--space-7);
    }
  }

  .team-intro__icon {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--color-river);
    color: var(--color-night);
    font-size: 2.25rem;
  }

  .team-intro__text {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .team-intro__body {
    max-width: 46rem;
    font-size: var(--text-xl);
    line-height: 1.55;
    color: var(--color-text-on-dark);
  }

  /* La pregunta es lo que invita a actuar: tipografía de títulos y color de acento. */
  .team-intro__question {
    max-width: 30ch;
    padding-left: var(--space-4);
    border-left: 4px solid var(--color-river);
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--color-river);
  }

  /* Flex centrado: la última fila incompleta queda en el centro y no pegada a un lado. */
  .people-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-7) var(--space-5);
  }

  .people-grid > :global(*) {
    flex: 1 1 15rem;
    max-width: 19rem;
  }

  .people-pending {
    margin-bottom: var(--space-6);
    color: var(--color-text-muted);
  }

  .people-ghost {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    opacity: 0.6;
  }
</style>
