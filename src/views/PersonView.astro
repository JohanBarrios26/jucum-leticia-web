---
/**
 * VISTA: PERFIL DE UNA PERSONA DEL EQUIPO (/personas/[slug]/)
 * ----------------------------------------------------------------------------
 * Foto grande, nombre, rol, país, ministerio y desde cuándo sirve; su frase e
 * historia; y dos acciones:
 *   - "Orar por <nombre>": su petición de oración + WhatsApp.
 *   - "Apoyar a <nombre>" (solo si tiene el apoyo activado): lleva a su enlace
 *     de donación personal o, si no tiene, a WhatsApp de JUCUM.
 * Cierra con otras personas del equipo.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PersonCard from '@/components/PersonCard.astro';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import RiverLine from '@/components/ui/RiverLine.astro';
import ReadMore from '@/components/ui/ReadMore.astro';
import Icon from '@/components/ui/Icon.astro';
import Timeline from '@/components/features/Timeline.astro';
import SmartImage from '@/components/ui/SmartImage.astro';
import { ministryAlternates, personAlternates, routes, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { getMinistries, getPeople, getSiteSettings, joinNames, ogImageUrl, whatsappUrl, type Person } from '@/lib/content';

interface Props {
  locale: Locale;
  person: Person;
}

const { locale, person: p } = Astro.props;
const ui = t(locale);
const [settings, ministries, people] = await Promise.all([getSiteSettings(locale), getMinistries(locale), getPeople(locale)]);
const ministry = ministries.find((m) => m.slug === p.ministrySlug);
const others = people.filter((x) => x.slug !== p.slug).slice(0, 4);

// WhatsApp: si la persona tiene el suyo, el mensaje le llega a ella. Si no, llega
// al de JUCUM y el mensaje dice por quién se está preguntando.
const wa = (text: string) => {
  if (p.whatsapp) return whatsappUrl(p.whatsapp, text);
  if (settings.whatsapp) return whatsappUrl(settings.whatsapp, `${ui.people.askingFor} ${p.name}. ${text}`);
  return routes.contact[locale];
};
const prayHref = wa(`${ui.people.prayMessage} ${p.name}.`);
const supportHref = p.support.link ?? wa(`${ui.people.supportMessage} ${p.name}.`);
const contactHref = wa(ui.people.contactMessage);

// Familias: adultos e hijos por separado ("Carlos y Ana" · "Samuel y Sofía").
const adults = p.members.filter((m) => m.relation === 'adult').map((m) => m.name);
const children = p.members.filter((m) => m.relation === 'child').map((m) => m.name);
const isFamily = p.members.length > 0;

// Foto completa: el marco toma la proporción real de la foto (horizontal o vertical), sin recortarla.
const ratio = p.photo?.width && p.photo?.height ? Math.min(2, Math.max(0.55, p.photo.width / p.photo.height)) : 0.8;

// Camino: línea de tiempo con los momentos clave de su historia.
const journey = {
  type: 'timeline' as const,
  title: ui.people.journey,
  intro: null,
  steps: p.milestones.map((m) => ({ label: m.label, title: m.title, text: m.text })),
};

// Petición de oración: si trae varias ideas, se muestran como tarjetas (no como un párrafo largo).
const prayerPoints = (p.prayerRequest ?? '')
  .split(/(?<=[.;])\s+/)
  .map((x) => x.trim().replace(/[.;]$/, ''))
  .filter((x) => x.length > 8)
  .map((x) => x.charAt(0).toUpperCase() + x.slice(1));
const prayerAsCards = prayerPoints.length >= 3;
---

<BaseLayout
  locale={locale}
  alternates={personAlternates(p.slug)}
  title={p.name}
  description={p.quote ?? p.role ?? undefined}
  ogImage={ogImageUrl(p.photo)}
  breadcrumbs={[
    { name: ui.nav.home, url: routes.home[locale] },
    { name: ui.nav.people, url: routes.people[locale] },
    { name: p.name, url: personAlternates(p.slug)[locale] },
  ]}
  pageEvent="person_view"
  pageItem={p.slug}
  headerOverlay
>
  <section class="profile surface-dark">
    <div class="container profile__grid">
      <div class="profile__photo" data-reveal="scale" style={`--r: ${ratio.toFixed(3)}`}>
        {p.photo ? <SmartImage image={p.photo} priority sizes="(min-width: 64rem) 40vw, 100vw" /> : <ImagePlaceholder label={p.name.charAt(0)} />}
      </div>

      <div class="profile__info">
        <a class="link-arrow profile__back" href={routes.people[locale]}><span aria-hidden="true">←</span> {ui.nav.people}</a>
        <h1 class="profile__name">{p.name}</h1>
        {p.role && <p class="lead profile__role">{p.role}</p>}
        {
          isFamily && (
            <ul role="list" class="profile__members" aria-label={ui.people.members}>
              {adults.length > 0 && (
                <li>
                  <span class="profile__members-label">{ui.people.family}</span>
                  {joinNames(adults, locale)}
                </li>
              )}
              {children.length > 0 && (
                <li>
                  <span class="profile__members-label">{ui.people.children}</span>
                  {joinNames(children, locale)}
                </li>
              )}
            </ul>
          )
        }
        <dl class="profile__facts">
          {
            p.country && (
              <div>
                <dt>{ui.people.from}</dt>
                <dd>{p.country}</dd>
              </div>
            )
          }
          {
            ministry && (
              <div>
                <dt>{ui.people.ministry}</dt>
                <dd>
                  <a href={ministryAlternates(ministry.slug)[locale]}>{ministry.name}</a>
                </dd>
              </div>
            )
          }
          {
            p.since && (
              <div>
                <dt>{ui.about.since}</dt>
                <dd>{p.since}</dd>
              </div>
            )
          }
        </dl>
        {p.quote && <blockquote class="profile__quote">“{p.quote}”</blockquote>}
        <div class="profile__cta">
          <a class="btn btn--primary" href={contactHref} target="_blank" rel="noopener" data-event="cta_person_contact_click">
            {ui.people.contactCta} {p.name} <span class="visually-hidden">{ui.newTab}</span><span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn--outline" href="#orar" data-event="cta_pray_click">
            {ui.people.pray} {p.name}
          </a>
        </div>
      </div>
    </div>
    <div class="container" aria-hidden="true"><RiverLine tone="light" /></div>
  </section>

  {
    p.bio && (
      <section class="section" aria-labelledby="story-title">
        <div class="container container--narrow">
          <h2 id="story-title" class="eyebrow eyebrow--line profile__label">
            {ui.people.story}
          </h2>
          <div data-reveal>
            <ReadMore text={p.bio} locale={locale} class="lead profile__bio" />
          </div>
        </div>
      </section>
    )
  }

  <!-- Su camino: momentos clave en línea de tiempo -->
  {
    p.milestones.length > 0 && (
      <section class="section surface-sand" aria-labelledby="journey-title">
        <div class="container">
          <Timeline locale={locale} block={journey} titleId="journey-title" />
        </div>
      </section>
    )
  }

  <!-- Cómo orar: ideas separadas en tarjetas -->
  {
    prayerAsCards && (
      <section class="section surface-dark" aria-labelledby="pray-points-title">
        <div class="container">
          <h2 id="pray-points-title" class="pray-title" data-reveal>
            {ui.people.prayFor} {p.name}
          </h2>
          <ul role="list" class="pray-grid">
            {prayerPoints.map((point, i) => (
              <li class="pray-card" data-reveal style={`--reveal-delay: ${(i % 3) * 80}ms`}>
                <span class="pray-card__icon" aria-hidden="true"><Icon name="heart" /></span>
                <p>{point}.</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Orar y apoyar -->
  <section id="orar" class="section surface-sand" aria-label={`${ui.people.pray} ${p.name}`}>
    <div class="container actions">
      <article class="action" data-reveal>
        <h2 class="action__title">{ui.people.contactTitle} {p.name}</h2>
        <p>{ui.people.contactText}</p>
        <a class="btn btn--dark" href={contactHref} target="_blank" rel="noopener" data-event="cta_person_contact_click">
          {ui.people.contactCta} {p.name} <span class="visually-hidden">{ui.newTab}</span><span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </article>

      <article class="action" data-reveal style="--reveal-delay: 60ms">
        <h2 class="action__title">{ui.people.pray} {p.name}</h2>
        <p>{prayerAsCards ? ui.people.prayText : (p.prayerRequest ?? ui.people.prayText)}</p>
        <a class="btn btn--dark" href={prayHref} target="_blank" rel="noopener" data-event="cta_pray_click">
          {ui.people.pray} {p.name} <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </article>

      {
        p.support.enabled && (
          <article class="action action--support" data-reveal style="--reveal-delay: 100ms">
            <h2 class="action__title">
              {ui.people.support} {p.name}
            </h2>
            <p>{p.support.text ?? ui.people.supportText}</p>
            <a class="btn btn--primary" href={supportHref} target="_blank" rel="noopener" data-event="cta_support_click">
              {ui.people.support} {p.name} <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
          </article>
        )
      }
    </div>
  </section>

  {
    others.length > 0 && (
      <section class="section" aria-labelledby="others-title">
        <div class="container">
          <h2 id="others-title" class="others-title">
            {ui.people.allTeam}
          </h2>
          <ul role="list" class="others">
            {others.map((x) => (
              <li data-reveal>
                <PersonCard locale={locale} person={x} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .pray-title {
    margin-bottom: var(--space-6);
  }

  .pray-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .pray-card {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-5);
    border: 1px solid var(--color-border-on-dark);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.04);
  }

  .pray-card__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-river);
    color: var(--color-night);
    font-size: 1.375rem;
  }

  .pray-card p {
    font-size: var(--text-lg, 1.125rem);
    line-height: 1.4;
  }

  .profile {
    padding-top: calc(var(--header-height) + var(--space-8));
  }

  .profile__grid {
    display: grid;
    gap: var(--space-7);
    align-items: end;
  }

  @media (min-width: 64rem) {
    .profile__grid {
      grid-template-columns: 1fr 1.2fr;
      gap: var(--space-9);
    }
  }

  /*
   * La foto se muestra COMPLETA: el marco tiene la misma proporción que la foto (--r = ancho/alto)
   * y nunca pasa del alto máximo. Las horizontales ocupan todo el ancho; las verticales, menos.
   */
  .profile__photo {
    --max-h: min(34rem, 70svh);
    aspect-ratio: var(--r, 0.8);
    width: min(100%, calc(var(--max-h) * var(--r, 0.8)));
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.35);
  }

  .profile__photo :global(img),
  .profile__photo :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .profile__back {
    color: var(--color-river);
  }

  .profile__name {
    margin-top: var(--space-5);
    font-size: var(--text-display);
    line-height: 0.88;
  }

  .profile__role {
    margin-top: var(--space-4);
    color: var(--color-river);
  }

  /* Integrantes de la familia: dos "píldoras" (adultos · hijos). */
  .profile__members {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-4);
  }

  .profile__members li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border-on-dark);
    border-radius: var(--radius-pill);
    font-size: var(--text-lg);
  }

  .profile__members-label {
    color: var(--color-river);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .profile__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-7);
    margin-top: var(--space-6);
  }

  .profile__facts dt {
    color: var(--color-text-on-dark-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .profile__facts dd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-lg);
  }

  .profile__quote {
    margin-top: var(--space-6);
    padding-left: var(--space-5);
    border-left: 3px solid var(--color-river);
    font-size: var(--text-xl);
    font-style: italic;
  }

  .profile__label {
    display: flex;
    margin-bottom: var(--space-5);
    color: var(--color-green);
  }

  .profile__bio {
    white-space: pre-line;
  }

  /* ---------- Orar / apoyar ---------- */
  .actions {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 48rem) {
    .actions {
      grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    }
  }

  .action {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    justify-items: start;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: var(--color-cloud);
  }

  .action--support {
    background: var(--color-night);
    color: var(--color-text-on-dark);
  }

  .action__title {
    font-size: var(--text-h3);
  }

  .others-title {
    margin-bottom: var(--space-7);
    font-size: var(--text-h3);
  }

  .others {
    display: grid;
    gap: var(--space-7) var(--space-5);
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }
</style>
