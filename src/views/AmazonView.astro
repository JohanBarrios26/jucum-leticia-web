---
/**
 * VISTA: VIVE EL AMAZONAS (/vive-el-amazonas/)
 * ----------------------------------------------------------------------------
 * Página aparte que muestra, de forma resumida e inmersiva, por qué venir a
 * JUCUM Leticia no es un viaje cualquiera:
 *   portada con foto → cifras (años, iglesias, países, escuelas) →
 *   "por qué no lo hace cualquiera" (tarjetas) → cómo llegar → fotos → llamado.
 *
 * El texto editable (título, frase, introducción, motivos, formas de llegar)
 * sale del panel: "Vive el Amazonas". Las cifras se calculan solas:
 *   - años: desde el año 2000 (inicio de JUCUM Leticia)
 *   - iglesias: la cifra del ministerio que muestra el mapa
 *   - escuelas: las escuelas activas; países: Colombia, Perú y Brasil.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import SmartImage from '@/components/ui/SmartImage.astro';
import PhotoGallery from '@/components/ui/PhotoGallery.astro';
import { amazonRoute, joinPathUrl, routes, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { getAmazonPage, getGallery, getMinistries, getSchools, ogImageUrl } from '@/lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const [page, gallery, ministries, schools] = await Promise.all([
  getAmazonPage(locale),
  getGallery(locale),
  getMinistries(locale),
  getSchools(locale),
]);
if (!page) throw new Error('Falta el documento "Vive el Amazonas" en Sanity.');

// Cifras (todas verificables o calculadas).
const START_YEAR = 2000;
const years = new Date().getFullYear() - START_YEAR;
const churchesBlock = ministries.find((m) => m.showMap)?.features.find((f) => f.type === 'stats');
const churches = churchesBlock && 'items' in churchesBlock ? churchesBlock.items[0]?.value : undefined;
const stats = [
  { value: String(years), label: ui.amazon.years },
  ...(churches ? [{ value: churches, label: ui.amazon.churches }] : []),
  { value: '3', label: ui.amazon.countries },
  { value: String(schools.length), label: ui.amazon.schools },
];

// Íconos simples de cada medio.
const icons = {
  air: 'M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z',
  river: 'M12 3v8M12 3l6 7h-6M3 14c2 0 2-1.5 4.5-1.5S10 14 12 14s2.5-1.5 4.5-1.5S19 14 21 14M3 19c2 0 2-1.5 4.5-1.5S10 19 12 19s2.5-1.5 4.5-1.5S19 19 21 19',
  walk: 'M5 19a2 2 0 1 0 0-.01M19 5a2 2 0 1 0 0-.01M5 17c0-6 14-4 14-10',
};
---

<BaseLayout
  locale={locale}
  alternates={amazonRoute}
  title={page.title}
  description={page.lead ?? page.tagline ?? undefined}
  ogImage={ogImageUrl(page.heroImage)}
  headerOverlay
  preloadImage={page.heroImage}
  breadcrumbs={[
    { name: ui.nav.home, url: routes.home[locale] },
    { name: page.title, url: amazonRoute[locale] },
  ]}
>
  <!-- Portada -->
  <section class="av-hero on-photo">
    {page.heroImage && (
      <div class="av-hero__bg" aria-hidden="true" data-live>
        <SmartImage image={page.heroImage} decorative priority sizes="100vw" />
      </div>
    )}
    <div class="container av-hero__inner">
      <p class="eyebrow eyebrow--line av-hero__eyebrow">{ui.amazon.eyebrow}</p>
      <h1 class="av-hero__title">{page.title}</h1>
      {page.tagline && <p class="av-hero__tagline">{page.tagline}</p>}
      <p class="av-hero__scroll" aria-hidden="true"><span></span>{ui.amazon.scroll}</p>
    </div>
  </section>

  <!-- Introducción y cifras -->
  <section class="section surface-deep av-intro" aria-label={page.title}>
    <div class="container">
      {page.lead && <p class="av-lead" data-reveal>{page.lead}</p>}
      <ul role="list" class="av-stats">
        {
          stats.map((s, i) => (
            <li data-reveal style={`--reveal-delay: ${i * 90}ms`}>
              <span class="av-stats__num">{s.value}</span>
              <span class="av-stats__label">{s.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Por qué no lo hace cualquiera -->
  {
    page.reasons.length > 0 && (
      <section class="section surface-sand" aria-labelledby="reasons-title">
        <div class="container">
          <h2 id="reasons-title" class="av-title" data-reveal>{ui.amazon.reasonsTitle}</h2>
          <ol class="av-reasons">
            {page.reasons.map((r, i) => (
              <li data-reveal style={`--reveal-delay: ${(i % 3) * 90}ms`}>
                <span class="av-reasons__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3>{r.title}</h3>
                {r.text && <p>{r.text}</p>}
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <!-- Cómo llegar -->
  {
    page.ways.length > 0 && (
      <section class="section surface-deep" aria-labelledby="ways-title">
        <div class="container">
          <h2 id="ways-title" class="av-title" data-reveal>{ui.amazon.waysTitle}</h2>
          <ul role="list" class="av-ways">
            {page.ways.map((w, i) => (
              <li data-reveal style={`--reveal-delay: ${i * 100}ms`}>
                <svg class:list={{ 'av-ways__air': w.mode === 'air' }} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={icons[w.mode]} /></svg>
                <h3>{w.title}</h3>
                {w.text && <p>{w.text}</p>}
              </li>
            ))}
          </ul>
          <p class="av-note">{ui.amazon.waysNote}</p>
        </div>
      </section>
    )
  }

  <!-- La vida aquí -->
  {
    gallery.length > 0 && (
      <section class="section surface-dark" aria-labelledby="life-title">
        <div class="container">
          <h2 id="life-title" class="av-title" data-reveal>{ui.amazon.galleryTitle}</h2>
          <PhotoGallery locale={locale} images={gallery.map((g) => g.image)} />
        </div>
      </section>
    )
  }

  <!-- Llamado final -->
  <section class="section av-cta" aria-labelledby="av-cta-title">
    <div class="container av-cta__inner">
      <h2 id="av-cta-title" class="av-title" data-reveal>{ui.amazon.ctaTitle}</h2>
      <p class="lead" data-reveal>{ui.amazon.ctaText}</p>
      <div class="av-cta__buttons" data-reveal>
        <a class="btn btn--primary btn--lg" href={`${routes.contact[locale]}?motivo=come`} data-event="amazon_cta_come">{ui.form.interests.come} <span class="btn__arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--outline" href={joinPathUrl('pray', locale)} data-event="amazon_cta_pray">{ui.form.interests.pray}</a>
        <a class="btn btn--outline" href={joinPathUrl('support', locale)} data-event="amazon_cta_support">{ui.form.interests.support}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Portada ---------- */
  .av-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: min(46rem, 88svh);
    padding-top: calc(var(--header-height) + var(--space-7));
    padding-bottom: var(--space-8);
    color: var(--color-text-on-dark);
    background: var(--color-night-deep);
    overflow: hidden;
    isolation: isolate;
  }

  .av-hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .av-hero__bg :global(img),
  .av-hero__bg :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: av-drift 30s ease-in-out infinite alternate;
  }

  @keyframes av-drift {
    from {
      transform: scale(1.03);
    }
    to {
      transform: scale(1.13) translateX(-1.5%);
    }
  }

  .av-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(10 29 29 / 0.92), rgb(10 29 29 / 0.25) 60%, rgb(10 29 29 / 0.55));
  }

  .av-hero__inner {
    display: grid;
    gap: var(--space-4);
  }

  .av-hero__eyebrow {
    color: var(--color-river);
  }

  .av-hero__title {
    font-size: clamp(4rem, 14vw, 12rem);
    line-height: 0.86;
    text-transform: uppercase;
    text-shadow: 0 0.5rem 3rem rgb(0 0 0 / 0.55);
  }

  .av-hero__tagline {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 3.2rem);
    line-height: 1;
    color: var(--color-river);
    text-transform: uppercase;
  }

  .av-hero__scroll {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-on-dark-muted);
  }

  .av-hero__scroll span {
    width: 3rem;
    height: 1px;
    background: currentColor;
  }

  /* ---------- Introducción y cifras ---------- */
  .av-lead {
    max-width: 52rem;
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    line-height: 1.35;
    color: var(--color-text-on-dark);
  }

  .av-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6) var(--space-5);
    margin-top: var(--space-8);
  }

  @media (min-width: 48rem) {
    .av-stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .av-stats li {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 3px solid var(--color-river);
  }

  .av-stats__num {
    font-family: var(--font-display);
    font-size: clamp(4rem, 9vw, 7.5rem);
    line-height: 0.85;
    color: var(--color-river);
    text-shadow: 0 0 2rem rgb(0 173 239 / 0.4);
  }

  .av-stats__label {
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* ---------- Secciones ---------- */
  .av-title {
    margin-bottom: var(--space-6);
    font-size: clamp(2.2rem, 5vw, 4rem);
    text-transform: uppercase;
  }

  .av-reasons {
    display: grid;
    gap: var(--space-5);
    counter-reset: none;
  }

  @media (min-width: 48rem) {
    .av-reasons {
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    }
  }

  .av-reasons li {
    position: relative;
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-6) var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .av-reasons__num {
    font-family: var(--font-display);
    font-size: 6rem;
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 2px var(--color-green);
  }

  .av-reasons h3 {
    font-size: var(--text-h3);
    line-height: 1.05;
    text-transform: uppercase;
  }

  .av-reasons p {
    color: var(--color-text-muted);
  }

  .av-ways {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 48rem) {
    .av-ways {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
  }

  .av-ways li {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-6) var(--space-5);
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: var(--radius-lg);
    background: linear-gradient(165deg, rgb(255 255 255 / 0.09), rgb(255 255 255 / 0.02));
  }

  .av-ways svg {
    width: 3rem;
    height: 3rem;
    fill: none;
    stroke: var(--color-river);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .av-ways li svg.av-ways__air {
    fill: var(--color-river);
    stroke: none;
  }

  .av-ways h3 {
    font-size: var(--text-h3);
    text-transform: uppercase;
  }

  .av-ways p {
    color: var(--color-text-on-dark-muted);
  }

  .av-note {
    margin-top: var(--space-5);
    color: var(--color-text-on-dark-muted);
    font-size: var(--text-sm);
  }

  /* ---------- Llamado final ---------- */
  .av-cta__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .av-cta__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-4);
  }

  @media (prefers-reduced-motion: reduce) {
    .av-hero__bg :global(img),
    .av-hero__bg :global(picture) {
      animation: none;
    }
  }
</style>
