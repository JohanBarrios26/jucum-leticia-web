---
/**
 * VISTA: PÁGINA INDIVIDUAL DE UN MINISTERIO (especificación §10)
 * ----------------------------------------------------------------------------
 * UNA sola plantilla para todos los ministerios: se alimenta con los datos de
 * cada uno (no se diseñan 7 páginas distintas). URL: /ministerios/[slug]/
 *
 * Estructura:
 *   portada (foto + motivo visual propio) → descripción y actividades →
 *   BLOQUES ESPECIALES (audios, ruta por el río, etapas… lo que el editor
 *   haya agregado: es lo que hace única a cada página) → quiénes sirven aquí →
 *   cómo participar → otros ministerios.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import MinistryCard from '@/components/MinistryCard.astro';
import PageHero from '@/components/PageHero.astro';
import PendingContent from '@/components/PendingContent.astro';
import PersonCard from '@/components/PersonCard.astro';
import AmazonMap from '@/components/AmazonMap.astro';
import Participate from '@/components/Participate.astro';
import ThemeStrip from '@/components/ThemeStrip.astro';
import FeatureBlocks from '@/components/features/FeatureBlocks.astro';
import { ministryAlternates, routes, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { getCommunities, getMinistries, getPeople, getSiteSettings, ogImageUrl, whatsappUrl, type Ministry } from '@/lib/content';

interface Props {
  locale: Locale;
  ministry: Ministry;
}

const { locale, ministry } = Astro.props;
const ui = t(locale);
const [settings, all, people, communities] = await Promise.all([
  getSiteSettings(locale),
  getMinistries(locale),
  getPeople(locale, ministry.slug),
  getCommunities(),
]);
const others = all.filter((m) => m.slug !== ministry.slug).slice(0, 3);
const contactHref = settings.whatsapp
  ? whatsappUrl(settings.whatsapp, `${ui.contact.whatsappMessage} (${ministry.name})`)
  : routes.contact[locale];
---

<BaseLayout
  locale={locale}
  alternates={ministryAlternates(ministry.slug)}
  title={ministry.name}
  description={ministry.shortDescription ?? undefined}
  ogImage={ogImageUrl(ministry.image)}
  preloadImage={ministry.image}
  breadcrumbs={[
    { name: ui.nav.home, url: routes.home[locale] },
    { name: ui.nav.ministries, url: routes.ministries[locale] },
    { name: ministry.name, url: ministryAlternates(ministry.slug)[locale] },
  ]}
  pageEvent="ministry_view"
  pageItem={ministry.slug}
  headerOverlay
>
  <PageHero
    title={ministry.name}
    lead={ministry.shortDescription}
    image={ministry.image}
    motif={ministry.motif}
    bigName
    back={{ href: routes.ministries[locale], label: ui.nav.ministries }}
  />

  <ThemeStrip motif={ministry.motif} />

  <!-- Descripción + actividades -->
  <section class="section">
    <div class="container detail-grid">
      <div data-reveal>
        <h2 class="eyebrow eyebrow--line detail-label">{ui.detail.about}</h2>
        {ministry.fullDescription ? <p class="lead">{ministry.fullDescription}</p> : <PendingContent locale={locale} />}
      </div>

      <div data-reveal style="--reveal-delay: 100ms">
        <h2 class="eyebrow eyebrow--line detail-label">{ui.detail.activities}</h2>
        {
          ministry.activities.length > 0 ? (
            <ul role="list" class="activity-list">
              {ministry.activities.map((a, i) => (
                <li>
                  <span class="activity-list__num">{String(i + 1).padStart(2, '0')}</span>
                  {a}
                </li>
              ))}
            </ul>
          ) : (
            <PendingContent locale={locale} />
          )
        }
      </div>
    </div>
  </section>

  <!-- Bloques especiales de este ministerio -->
  <FeatureBlocks locale={locale} blocks={ministry.features} />

  <!-- Mapa interactivo de comunidades (solo en el ministerio que lo tiene activado) -->
  {
    ministry.showMap && communities.length > 0 && (
      <section class="section surface-deep" aria-labelledby="reach-title">
        <div class="container">
          <h2 id="reach-title" class="eyebrow eyebrow--line">{ui.reach.title}</h2>
          <AmazonMap locale={locale} communities={communities} titleId="reach-title" />
        </div>
      </section>
    )
  }

  <!-- Quiénes sirven aquí -->
  {
    people.length > 0 && (
      <section class="section" aria-labelledby="ministry-team-title">
        <div class="container">
          <h2 id="ministry-team-title" class="detail-team-title" data-reveal>
            {ui.detail.team}
          </h2>
          <ul role="list" class="team">
            {people.map((p) => (
              <li data-reveal>
                <PersonCard locale={locale} person={p} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Cómo participar (interactivo en el ministerio destacado con mapa; simple en los demás) -->
  <ThemeStrip motif={ministry.motif} />
  <Participate locale={locale} name={ministry.name} whatsapp={settings.whatsapp} variant={ministry.showMap ? 'interactive' : 'simple'} motif={ministry.motif} />

  <!-- Otros ministerios -->
  {
    others.length > 0 && (
      <section class="section surface-dark others-section">
        <div class="container">
          <h2 class="eyebrow eyebrow--line others-label">{ui.detail.otherMinistries}</h2>
          <ul role="list" class="others">
            {others.map((m) => (
              <li data-reveal>
                <MinistryCard
                  locale={locale}
                  ministry={m}
                  number={all.indexOf(m) + 1}
                  sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 90vw"
                />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .detail-grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 64rem) {
    .detail-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .detail-label {
    display: flex;
    margin-bottom: var(--space-5);
    color: var(--color-green);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    line-height: 1.4;
  }

  /* Actividades como fichas, no como lista simple. */
  .activity-list {
    display: grid;
    gap: var(--space-3);
  }

  .activity-list li {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-4) var(--space-5);
    border-left: 4px solid var(--color-green);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    box-shadow: var(--shadow);
    font-size: var(--text-lg, 1.25rem);
    font-weight: 600;
    transition: transform var(--duration) var(--ease);
  }

  .activity-list li:hover {
    transform: translateX(6px);
  }

  @media (prefers-reduced-motion: reduce) {
    .activity-list li {
      transition: none;
    }

    .activity-list li:hover {
      transform: none;
    }
  }

  .activity-list__num {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-green);
  }

  .detail-team-title {
    margin-bottom: var(--space-7);
  }

  .team {
    display: grid;
    gap: var(--space-7) var(--space-5);
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }

  .participate {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .participate__text {
    max-width: 36rem;
    color: var(--color-text-on-dark-muted);
  }

  .others-section {
    padding-top: 0;
  }

  .others-label {
    margin-bottom: var(--space-6);
    color: var(--color-river);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    line-height: 1.4;
  }

  .others {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 40rem) {
    .others {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .others {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
