---
/**
 * VISTA: PÁGINA INDIVIDUAL DE UN MINISTERIO (especificación §10)
 * ----------------------------------------------------------------------------
 * UNA sola plantilla para todos los ministerios: se alimenta con los datos de
 * cada uno (no se diseñan 7 páginas distintas). URL: /ministerios/[slug]/
 *
 * Estructura: foto grande + nombre → descripción → qué hacemos (actividades)
 * → cómo participar → otros ministerios.
 * Las partes sin información confirmada muestran "Pendiente de contenido".
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import SmartImage from '@/components/ui/SmartImage.astro';
import PendingContent from '@/components/PendingContent.astro';
import { ministryAlternates, routes, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { getMinistries, getSiteSettings, whatsappUrl, type Ministry } from '@/lib/content';

interface Props {
  locale: Locale;
  ministry: Ministry;
}

const { locale, ministry } = Astro.props;
const ui = t(locale);
const [settings, all] = await Promise.all([getSiteSettings(locale), getMinistries(locale)]);
const others = all.filter((m) => m.slug !== ministry.slug).slice(0, 3);
const contactHref = settings.whatsapp
  ? whatsappUrl(settings.whatsapp, `${ui.contact.whatsappMessage} (${ministry.name})`)
  : routes.contact[locale];
---

<BaseLayout
  locale={locale}
  alternates={ministryAlternates(ministry.slug)}
  title={ministry.name}
  description={ministry.shortDescription ?? undefined}
  headerOverlay
>
  <!-- Portada -->
  <section class="cover on-photo">
    <div class="cover__media">
      {ministry.image ? <SmartImage image={ministry.image} priority sizes="100vw" /> : <ImagePlaceholder />}
    </div>
    <div class="container cover__content">
      <a class="link-arrow cover__back" href={routes.ministries[locale]}><span aria-hidden="true">←</span> {ui.nav.ministries}</a>
      <h1 class="cover__title">{ministry.name}</h1>
      {ministry.shortDescription && <p class="lead cover__lead">{ministry.shortDescription}</p>}
    </div>
  </section>

  <!-- Descripción + actividades -->
  <section class="section">
    <div class="container detail-grid">
      <div data-reveal>
        <h2 class="eyebrow eyebrow--line detail-label">{ui.detail.about}</h2>
        {ministry.fullDescription ? <p class="lead">{ministry.fullDescription}</p> : <PendingContent locale={locale} />}
      </div>

      <div data-reveal style="--reveal-delay: 100ms">
        <h2 class="eyebrow eyebrow--line detail-label">{ui.detail.activities}</h2>
        {
          ministry.activities.length > 0 ? (
            <ul role="list" class="activity-list">
              {ministry.activities.map((a, i) => (
                <li>
                  <span class="activity-list__num">{String(i + 1).padStart(2, '0')}</span>
                  {a}
                </li>
              ))}
            </ul>
          ) : (
            <PendingContent locale={locale} />
          )
        }
      </div>
    </div>
  </section>

  <!-- Cómo participar -->
  <section class="section surface-dark participate">
    <div class="container participate__inner">
      <h2 data-reveal>{ui.detail.participate}</h2>
      <p class="lead participate__text" data-reveal style="--reveal-delay: 80ms">{ui.detail.participateText}</p>
      <a class="btn btn--primary" href={contactHref} target="_blank" rel="noopener" data-event="whatsapp_click" data-reveal style="--reveal-delay: 160ms">
        {ui.home.contactTitle} <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- Otros ministerios -->
  {
    others.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="eyebrow eyebrow--line detail-label">{ui.detail.otherMinistries}</h2>
          <ul role="list" class="others">
            {others.map((m, i) => (
              <li data-reveal style={`--reveal-delay: ${i * 90}ms`}>
                <a href={ministryAlternates(m.slug)[locale]} class="other">
                  <div class="other__media">
                    {m.image ? <SmartImage image={m.image} decorative sizes="(min-width: 48rem) 30vw, 90vw" widths={[480, 768]} /> : <ImagePlaceholder />}
                  </div>
                  <span class="other__name">{m.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* ---------- Portada ---------- */
  .cover {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(44rem, 85svh);
    padding-top: calc(var(--header-height) + var(--space-8));
    padding-bottom: var(--space-8);
    color: var(--color-text-on-dark);
    background: var(--color-night-deep);
    overflow: hidden;
    isolation: isolate;
  }

  .cover__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .cover__media :global(img),
  .cover__media :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(10 29 29 / 0.92), rgb(10 29 29 / 0.25) 60%, rgb(10 29 29 / 0.55));
  }

  .cover__back {
    color: var(--color-river);
  }

  .cover__title {
    margin-top: var(--space-5);
    font-size: var(--text-display);
    line-height: 0.88;
  }

  .cover__lead {
    max-width: 40rem;
    margin-top: var(--space-5);
    opacity: 0.9;
  }

  /* ---------- Contenido ---------- */
  .detail-grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 64rem) {
    .detail-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .detail-label {
    margin-bottom: var(--space-5);
    color: var(--color-green);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    line-height: 1.4;
  }

  .activity-list {
    border-top: 1px solid var(--color-border);
  }

  .activity-list li {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-xl);
    font-weight: 500;
  }

  .activity-list__num {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-green);
  }

  .participate__inner {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .participate__text {
    max-width: 36rem;
    color: var(--color-text-on-dark-muted);
  }

  .others {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 48rem) {
    .others {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .other {
    display: grid;
    gap: var(--space-3);
    color: var(--color-night);
    text-decoration: none;
  }

  .other__media {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .other__media :global(img),
  .other__media :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease);
  }

  .other:hover .other__media :global(img) {
    transform: scale(1.05);
  }

  .other__name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    text-transform: uppercase;
  }
</style>
