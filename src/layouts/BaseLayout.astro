---
/**
 * PLANTILLA BASE DE TODAS LAS PÁGINAS
 * ----------------------------------------------------------------------------
 * Arma el <html> completo: etiquetas SEO del <head>, encabezado, contenido de
 * la página (<slot />) y pie. Toda página del sitio se envuelve en este layout.
 *
 * Uso:
 *   <BaseLayout locale="es" alternates={routes.about} title="Quiénes somos">
 *     ...contenido de la página...
 *   </BaseLayout>
 *
 * SEO (especificación §25): título, descripción, URL canónica, versiones en
 * otros idiomas (hreflang), imagen para redes sociales (Open Graph) y datos
 * estructurados para Google (JSON-LD: organización y ruta de navegación).
 *
 * Analítica (especificación §33): si hay PUBLIC_UMAMI_WEBSITE_ID se carga
 * Umami (sin cookies) y src/scripts/analytics.ts registra los eventos.
 */
import '@fontsource/bebas-neue';
import '@fontsource-variable/inter';
import '@/styles/global.css';

// URLs de las tipografías principales (solo el subconjunto latino) para precargarlas.
import bebasLatin from '@fontsource/bebas-neue/files/bebas-neue-latin-400-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { defaultLocale, locales, type Alternates, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { umamiWebsiteId } from '@/lib/config';
import { getHome, getSiteSettings, ogImageUrl, type ImageRef } from '@/lib/content';
import { remoteSrcset } from '@/lib/images';

interface Props {
  locale: Locale;
  /** URL de ESTA página en cada idioma (para hreflang y el selector de idioma). */
  alternates: Alternates;
  /** Título de la página; se le agrega " | JUCUM Leticia". Omitir en el inicio. */
  title?: string;
  /** Título completo sin agregados (lo usa la página de inicio). */
  fullTitle?: string;
  description?: string;
  /** Imagen al compartir en redes (URL). Por defecto: la foto de portada del inicio. */
  ogImage?: string;
  /** true = pedir a Google que no indexe esta página (ej. 404). */
  noindex?: boolean;
  /** Encabezado transparente sobre una foto a pantalla completa (inicio). */
  headerOverlay?: boolean;
  /** Ruta de navegación para Google, ej. [{ name: 'Ministerios', url: '/ministerios/' }, …]. */
  breadcrumbs?: { name: string; url: string }[];
  /** Incluir los datos de la organización para Google (solo en el inicio). */
  organizationSchema?: boolean;
  /** Evento de analítica al abrir la página (ej. 'ministry_view') y su elemento. */
  pageEvent?: string;
  pageItem?: string;
  /** Foto de portada a precargar (la primera que se ve): acelera la carga. */
  preloadImage?: ImageRef | null;
}

const {
  locale,
  alternates,
  title,
  fullTitle,
  description,
  ogImage,
  noindex = false,
  headerOverlay = false,
  breadcrumbs,
  organizationSchema = false,
  pageEvent,
  pageItem,
  preloadImage,
} = Astro.props;

// Precarga de la portada (solo fotos del panel; mismo srcset que SmartImage).
const preloadSrcset = preloadImage && typeof preloadImage.src === 'string' ? remoteSrcset(preloadImage) : null;

const [settings, home] = await Promise.all([getSiteSettings(locale), getHome(locale)]);
const ui = t(locale);

const pageTitle = fullTitle ?? (title ? `${title} | ${settings.organizationName}` : settings.organizationName);
const metaDescription = description ?? settings.shortDescription;
// `site` viene de astro.config.mjs (dominio final del sitio).
const site = Astro.site ?? Astro.url;
// La analítica solo se activa en el dominio publicado (no en localhost), y
// Umami solo cuenta visitas de ese dominio (data-domains).
const siteHost = new URL(site).hostname;
const analyticsEnabled = Boolean(umamiWebsiteId) && siteHost !== 'localhost';
const canonical = new URL(alternates[locale], site).href;
const ogImageFinal = ogImage ?? ogImageUrl(home.hero.image) ?? new URL('/brand/logo-original.png', site).href;
const ogLocale = { es: 'es_CO', en: 'en_US' } satisfies Record<Locale, string>;

// ---- Datos estructurados (JSON-LD) para Google ----
const jsonLd: object[] = [];
if (organizationSchema) {
  const sameAs = Object.values(settings.social).filter(Boolean);
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'NGO',
    name: settings.organizationName,
    description: settings.shortDescription,
    url: new URL(alternates[locale], site).href,
    logo: new URL('/brand/logo-original.png', site).href,
    image: ogImageFinal,
    email: settings.email,
    telephone: settings.phones.map((p) => p.number),
    address: { '@type': 'PostalAddress', addressLocality: 'Leticia', addressRegion: 'Amazonas', addressCountry: 'CO' },
    ...(sameAs.length > 0 && { sameAs }),
  });
}
if (breadcrumbs && breadcrumbs.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: new URL(b.url, site).href,
    })),
  });
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Marca que JavaScript está disponible. Las animaciones de aparición solo
      ocultan contenido si esta clase existe (ver global.css, sección 5).
    -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Conexión temprana con el CDN de imágenes de Sanity. -->
    <link rel="preconnect" href="https://cdn.sanity.io" />
    {
      preloadSrcset && (
        <link rel="preload" as="image" imagesrcset={preloadSrcset} imagesizes="100vw" fetchpriority="high" />
      )
    }
    <!-- Precarga de tipografías: el título grande aparece sin saltos. -->
    <link rel="preload" href={bebasLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Versiones de esta página en otros idiomas -->
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(alternates[l], site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates[defaultLocale], site).href} />

    <!-- Vista previa al compartir en redes sociales / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.organizationName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageFinal} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageFinal} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    <!-- Analítica sin cookies (solo si está configurada) -->
    {
      analyticsEnabled && (
        <script
          is:inline
          defer
          data-umami
          src="https://cloud.umami.is/script.js"
          data-website-id={umamiWebsiteId}
          data-domains={siteHost}
        />
      )
    }

    <meta name="theme-color" content="#102a2a" />
    <link rel="icon" type="image/png" href="/brand/logo-dark.png" />
    <link rel="apple-touch-icon" href="/brand/logo-original.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body data-page-event={pageEvent} data-page-item={pageItem}>
    <a class="skip-link" href="#main">{ui.skipToContent}</a>
    <Header locale={locale} alternates={alternates} settings={settings} overlay={headerOverlay} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} settings={settings} />

    <!-- Animaciones de aparición (data-reveal) y registro de eventos de analítica. -->
    <script>
      import '@/scripts/reveal';
      import '@/scripts/analytics';
    </script>
  </body>
</html>
