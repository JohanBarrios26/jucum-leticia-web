---
/**
 * ENCABEZADO DE PÁGINA INTERIOR
 * ----------------------------------------------------------------------------
 * Banda oscura con título grande que abre las páginas internas (Quiénes somos,
 * Ministerios, Escuelas...). Lo que se ponga dentro (<slot />) aparece debajo
 * del texto, por ejemplo botones.
 *
 * Uso: <PageHeader title="Ministerios" eyebrow="JUCUM Leticia" lead="Texto..." />
 */
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
}

const { title, eyebrow, lead } = Astro.props;
---

<section class="page-header surface-dark">
  <div class="container">
    {eyebrow && <p class="eyebrow eyebrow--line page-header__eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead page-header__lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-header {
    padding-block: var(--space-9) var(--space-8);
  }

  .page-header__eyebrow {
    margin-bottom: var(--space-4);
    color: var(--color-river);
  }

  .page-header__lead {
    max-width: 40rem;
    margin-top: var(--space-5);
    color: var(--color-text-on-dark-muted);
  }
</style>
