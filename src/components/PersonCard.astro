---
/**
 * TARJETA DE PERSONA DEL EQUIPO
 * ----------------------------------------------------------------------------
 * Foto, nombre, rol y país. Toda la tarjeta lleva al perfil completo
 * (/personas/<identificador>/), donde están su historia, cómo orar por ella y
 * cómo apoyarla. Si recibe apoyo personal, muestra una etiqueta.
 * Solo llegan aquí personas que autorizaron publicar sus datos (getPeople()).
 */
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import SmartImage from '@/components/ui/SmartImage.astro';
import { personAlternates, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import type { Person } from '@/lib/content';

interface Props {
  locale: Locale;
  person: Person;
}

const { locale, person: p } = Astro.props;
const ui = t(locale).people;
---

<a class="person-card" href={personAlternates(p.slug)[locale]} data-event="person_card_click">
  <div class="person-card__photo">
    {p.photo ? <SmartImage image={p.photo} decorative sizes="(min-width: 64rem) 22rem, 90vw" widths={[480, 768]} /> : <ImagePlaceholder label={p.name.charAt(0)} />}
    {p.support.enabled && <span class="person-card__badge">{ui.supportBadge}</span>}
  </div>
  <h3 class="person-card__name">{p.name}</h3>
  {p.role && <p class="person-card__role">{p.role}</p>}
  {
    p.country && (
      <p class="person-card__country">
        {ui.from} {p.country}
      </p>
    )
  }
  <span class="link-arrow person-card__more">
    {ui.viewProfile} <span aria-hidden="true">→</span>
  </span>
</a>

<style>
  .person-card {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    color: var(--color-night);
    text-decoration: none;
  }

  .person-card__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    margin-bottom: var(--space-3);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .person-card__photo :global(img),
  .person-card__photo :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease);
  }

  .person-card:hover .person-card__photo :global(img) {
    transform: scale(1.05);
  }

  .person-card__badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-river);
    color: var(--color-night);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .person-card__name {
    font-size: var(--text-2xl);
  }

  .person-card__role {
    color: var(--color-green);
    font-weight: 600;
  }

  .person-card__country {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .person-card__more {
    margin-top: var(--space-2);
    color: var(--color-green);
  }
</style>
