---
/**
 * TARJETA DE PERSONA DEL EQUIPO
 * ----------------------------------------------------------------------------
 * Foto, nombre, rol, desde cuándo sirve y su frase. Si tiene petición de
 * oración, se muestra en un recuadro aparte. Solo llegan aquí personas que
 * autorizaron publicar sus datos (lo filtra getPeople()).
 */
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import SmartImage from '@/components/ui/SmartImage.astro';
import type { Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import type { Person } from '@/lib/content';

interface Props {
  locale: Locale;
  person: Person;
}

const { locale, person: p } = Astro.props;
const ui = t(locale).about;
---

<article class="person">
  <div class="person__photo">
    {p.photo ? <SmartImage image={p.photo} sizes="(min-width: 64rem) 22rem, 90vw" widths={[480, 768]} /> : <ImagePlaceholder label={p.name.charAt(0)} />}
  </div>
  <h3 class="person__name">{p.name}</h3>
  {p.role && <p class="person__role">{p.role}</p>}
  {
    p.since && (
      <p class="person__since">
        {ui.since} {p.since}
      </p>
    )
  }
  {p.quote && <blockquote class="person__quote">“{p.quote}”</blockquote>}
  {p.bio && <p class="person__bio">{p.bio}</p>}
  {
    p.prayerRequest && (
      <div class="person__prayer">
        <p class="person__prayer-label">{ui.prayFor}</p>
        <p>{p.prayerRequest}</p>
      </div>
    )
  }
</article>

<style>
  .person {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .person__photo {
    aspect-ratio: 4 / 5;
    margin-bottom: var(--space-3);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .person__photo :global(img),
  .person__photo :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .person__name {
    font-size: var(--text-2xl);
  }

  .person__role {
    color: var(--color-green);
    font-weight: 600;
  }

  .person__since {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .person__quote {
    margin-top: var(--space-2);
    font-style: italic;
  }

  .person__bio {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .person__prayer {
    margin-top: var(--space-3);
    padding: var(--space-4);
    border-left: 3px solid var(--color-river);
    background: var(--color-white);
    font-size: var(--text-sm);
  }

  .person__prayer-label {
    color: var(--color-green);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }
</style>
