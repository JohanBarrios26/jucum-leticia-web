---
/**
 * BLOQUE: TARJETAS CON ICONO
 * ----------------------------------------------------------------------------
 * Para contar de forma visual lo que se vive en una escuela, ministerio o base
 * (qué aprenderás, en qué consiste, qué ofrecemos). Cada tarjeta lleva un
 * icono propio (components/ui/Icon.astro), un título corto y una o dos frases.
 * Se edita en el panel: Bloques especiales → Tarjetas con icono.
 */
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import type { FeatureBlock } from '@/lib/content';

interface Props {
  block: Extract<FeatureBlock, { type: 'highlights' }>;
  titleId: string;
}

const { block, titleId } = Astro.props;
---

{
  block.items.length > 0 && (
    <div class="hl">
      <div class="hl__head" data-reveal>
        <h2 id={titleId} class:list={['hl__title', { 'visually-hidden': !block.title }]}>
          {block.title ?? ''}
        </h2>
        {block.intro && <p class="hl__intro">{block.intro}</p>}
      </div>
      <ul role="list" class="hl__grid" style={`--n: ${block.items.length}`}>
        {block.items.map((item, i) => (
          <li class="hl__card" data-reveal style={`--reveal-delay: ${(i % 3) * 90}ms`}>
            <span class="hl__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="hl__icon" aria-hidden="true">
              <Icon name={item.icon as IconName} />
            </span>
            <h3 class="hl__card-title">{item.title}</h3>
            {item.text && <p class="hl__text">{item.text}</p>}
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .hl__head {
    display: grid;
    gap: var(--space-3);
    max-width: 44rem;
    margin-bottom: var(--space-7);
  }

  .hl__intro {
    color: var(--color-text-muted);
    font-size: var(--text-lg, 1.125rem);
  }

  /*
   * Las tarjetas se reparten parejo (6 → 3+3, 4 → 4, 5 → 3+2 con la última fila centrada):
   * --cols sale de la cantidad (--n) y las filas incompletas quedan centradas, sin huecos a un lado.
   */
  .hl__grid {
    --cols: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  .hl__grid > :global(.hl__card) {
    flex: 0 0 calc((100% - (var(--cols) - 1) * var(--space-4)) / var(--cols));
  }

  @media (min-width: 36rem) {
    .hl__grid {
      --cols: 2;
    }
  }

  @media (min-width: 64rem) {
    .hl__grid {
      --cols: clamp(2, var(--n), 4);
    }

    /* 5 y 6 tarjetas: tres por fila (4+2 deja un hueco; 3+3 y 3+2 quedan equilibradas). */
    .hl__grid:is([style*='--n: 5'], [style*='--n: 6'], [style*='--n: 9']) {
      --cols: 3;
    }
  }

  .hl__card {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6) var(--space-5) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    overflow: hidden;
    transition:
      transform var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
  }

  /* Línea de color que crece al pasar el mouse. */
  .hl__card::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 4px;
    background: linear-gradient(90deg, var(--color-river), var(--color-green));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 500ms var(--ease);
  }

  .hl__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 1rem 2rem rgb(10 29 29 / 0.1);
  }

  .hl__card:hover::after {
    transform: scaleX(1);
  }

  /* Número grande y tenue en la esquina: da ritmo a la fila de tarjetas. */
  .hl__num {
    position: absolute;
    top: var(--space-3);
    right: var(--space-4);
    color: var(--color-night);
    font-family: var(--font-display);
    font-size: 3.25rem;
    line-height: 1;
    opacity: 0.07;
    transition: opacity var(--duration) var(--ease);
  }

  .hl__card:hover .hl__num {
    opacity: 0.18;
  }

  .hl__card:hover .hl__icon {
    box-shadow: 0 0 0 0.5rem rgb(0 173 239 / 0.16);
  }

  .hl__icon {
    transition: box-shadow 400ms var(--ease);
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--color-night);
    color: var(--color-river);
    font-size: 1.625rem;
  }

  .hl__card-title {
    font-size: var(--text-lg, 1.125rem);
    line-height: 1.2;
  }

  .hl__text {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .hl__card,
    .hl__card::after {
      transition: none;
    }
  }
</style>
