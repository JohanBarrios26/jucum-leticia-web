---
/**
 * BLOQUE: AUDIOS DE LA PALABRA (pensado para OBT)
 * ----------------------------------------------------------------------------
 * Tarjetas con pasajes bíblicos grabados en lenguas de las comunidades.
 * Cada tarjeta muestra: en qué lengua se escucha, la cita bíblica y qué dice
 * el texto (en el idioma de la página), además de un reproductor propio.
 *
 * Rendimiento: el audio NO se descarga al abrir la página. El <audio> se
 * crea recién cuando la persona presiona "Reproducir" (preload="none").
 * Así, 10 audios no agregan ni 1 KB a la carga inicial.
 *
 * Solo se muestran audios marcados como "Autorizado para publicar".
 * Si aún no hay audios: con showPending se ven 2 tarjetas de ejemplo
 * deshabilitadas; en producción el bloque no se muestra.
 */
import PendingContent from '@/components/PendingContent.astro';
import type { Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { showPending } from '@/lib/config';
import type { FeatureBlock } from '@/lib/content';

type Block = Extract<FeatureBlock, { type: 'audioSamples' }>;

interface Props {
  locale: Locale;
  block: Block;
  /** ID único del título (puede haber varios bloques en la página). */
  titleId: string;
}

const { locale, block, titleId } = Astro.props;
const ui = t(locale).features;
const hasSamples = block.samples.length > 0;

// Barras decorativas de la onda (se "llenan" a medida que avanza el audio).
const bars = [30, 55, 80, 45, 95, 60, 35, 70, 100, 50, 25, 65, 85, 40, 75, 55, 90, 35, 60, 45, 80, 30, 55, 70];
---

{
  (hasSamples || showPending) && (
    <div class="audio-block" data-audio-block>
      <div class="audio-block__head" data-reveal>
        <h2 id={titleId}>{block.title ?? ui.audioTitle}</h2>
        {block.intro && <p class="lead">{block.intro}</p>}
      </div>

      {hasSamples ? (
        <ul role="list" class="audio-grid">
          {block.samples.map((s, i) => (
            <li class="audio-card" data-reveal style={`--reveal-delay: ${i * 80}ms`} data-audio-card>
              <div class="audio-card__top">
                <span class="audio-card__lang">
                  <span class="visually-hidden">{ui.audioLanguage}: </span>
                  {s.language}
                </span>
                {s.community && <span class="audio-card__community">{s.community}</span>}
              </div>

              <p class="audio-card__ref">{s.reference}</p>

              <div class="audio-card__player">
                <button
                  type="button"
                  class="audio-card__play"
                  data-audio-src={s.audioUrl}
                  data-audio-type={s.mimeType ?? undefined}
                  data-label-play={`${ui.audioPlay}: ${s.reference} (${s.language})`}
                  data-label-pause={`${ui.audioPause}: ${s.reference} (${s.language})`}
                  aria-label={`${ui.audioPlay}: ${s.reference} (${s.language})`}
                  data-event="audio_play"
                >
                  <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                  <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
                </button>
                <div class="audio-card__wave" aria-hidden="true">
                  {bars.map((h) => <span style={`--h: ${h}%`} />)}
                </div>
                <span class="audio-card__time" aria-hidden="true" data-audio-time>
                  0:00
                </span>
              </div>

              <div class="audio-card__meaning">
                <p class="audio-card__label">{ui.audioMeaning}</p>
                <p>{s.text}</p>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <div class="audio-grid">
          {[1, 2].map(() => (
            <div class="audio-card audio-card--ghost" aria-hidden="true">
              <div class="audio-card__top">
                <span class="audio-card__lang">{ui.audioLanguage}</span>
              </div>
              <p class="audio-card__ref">— —</p>
              <div class="audio-card__player">
                <span class="audio-card__play">
                  <svg class="icon-play" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
                </span>
                <div class="audio-card__wave">
                  {bars.map((h) => <span style={`--h: ${h}%`} />)}
                </div>
              </div>
            </div>
          ))}
          <p class="audio-grid__pending">
            {ui.audioPending} <PendingContent locale={locale} />
          </p>
        </div>
      )}
    </div>
  )
}

<script>
  /*
   * Reproductor: crea el <audio> recién al primer clic, permite un solo audio
   * sonando a la vez y actualiza la onda (--progress) y el tiempo transcurrido.
   */
  let current: { audio: HTMLAudioElement; card: HTMLElement; button: HTMLButtonElement } | null = null;

  const format = (sec: number) => {
    const s = Math.max(0, Math.floor(sec));
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  };

  function setState(card: HTMLElement, button: HTMLButtonElement, playing: boolean) {
    card.toggleAttribute('data-playing', playing);
    button.setAttribute('aria-label', (playing ? button.dataset.labelPause : button.dataset.labelPlay) ?? '');
  }

  document.querySelectorAll<HTMLButtonElement>('button[data-audio-src]').forEach((button) => {
    const card = button.closest<HTMLElement>('[data-audio-card]');
    const time = card?.querySelector<HTMLElement>('[data-audio-time]');
    if (!card) return;
    let audio: HTMLAudioElement | null = null;

    button.addEventListener('click', () => {
      if (!audio) {
        // Primera vez: se crea el audio (aquí recién empieza la descarga).
        audio = new Audio();
        audio.preload = 'none';
        audio.src = button.dataset.audioSrc!;
        audio.addEventListener('timeupdate', () => {
          const p = audio!.duration ? audio!.currentTime / audio!.duration : 0;
          card.style.setProperty('--progress', String(p));
          if (time) time.textContent = format(audio!.currentTime);
        });
        audio.addEventListener('ended', () => {
          setState(card, button, false);
          card.style.setProperty('--progress', '0');
        });
        audio.addEventListener('pause', () => setState(card, button, false));
        audio.addEventListener('play', () => setState(card, button, true));
        audio.addEventListener('waiting', () => card.setAttribute('data-loading', ''));
        audio.addEventListener('playing', () => card.removeAttribute('data-loading'));
      }

      if (audio.paused) {
        // Pausa el que esté sonando en otra tarjeta.
        if (current && current.audio !== audio) current.audio.pause();
        current = { audio, card, button };
        void audio.play();
      } else {
        audio.pause();
      }
    });
  });
</script>

<style>
  .audio-block__head {
    display: grid;
    gap: var(--space-4);
    max-width: 44rem;
    margin-bottom: var(--space-7);
  }

  .audio-block__head .lead {
    color: var(--color-text-on-dark-muted);
  }

  .audio-grid {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 48rem) {
    .audio-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 72rem) {
    .audio-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .audio-grid__pending {
    grid-column: 1 / -1;
    color: var(--color-text-on-dark-muted);
  }

  /* ---------- Tarjeta ---------- */
  .audio-card {
    --progress: 0;
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding: var(--space-6);
    border: 1px solid var(--color-border-on-dark);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.03);
    transition:
      border-color 400ms var(--ease),
      background-color 400ms var(--ease);
  }

  .audio-card[data-playing] {
    border-color: var(--color-river);
    background: rgb(0 173 239 / 0.08);
  }

  .audio-card--ghost {
    opacity: 0.45;
    border-style: dashed;
  }

  .audio-card__top {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .audio-card__lang {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-river);
    color: var(--color-night);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .audio-card__community {
    color: var(--color-text-on-dark-muted);
    font-size: var(--text-sm);
  }

  .audio-card__ref {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: 1;
    text-transform: uppercase;
  }

  /* ---------- Reproductor ---------- */
  .audio-card__player {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
  }

  .audio-card__play {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border: 0;
    border-radius: 50%;
    background: var(--color-river);
    color: var(--color-night);
    transition:
      transform var(--duration) var(--ease),
      background-color var(--duration) var(--ease);
  }

  button.audio-card__play:hover {
    background: var(--color-river-hover);
    transform: scale(1.06);
  }

  .audio-card__play svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: currentColor;
  }

  .audio-card .icon-pause,
  .audio-card[data-playing] .icon-play {
    display: none;
  }

  .audio-card[data-playing] .icon-pause {
    display: block;
  }

  /* Mientras carga, el botón late suavemente. */
  .audio-card[data-loading] .audio-card__play {
    animation: loading-pulse 900ms var(--ease-in-out) infinite alternate;
  }

  @keyframes loading-pulse {
    to {
      opacity: 0.5;
    }
  }

  /* Onda: las barras a la izquierda del progreso se pintan de azul. */
  .audio-card__wave {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 2.5rem;
    -webkit-mask: linear-gradient(to right, #000 calc(var(--progress) * 100%), rgb(0 0 0 / 0.35) calc(var(--progress) * 100%));
    mask: linear-gradient(to right, #000 calc(var(--progress) * 100%), rgb(0 0 0 / 0.35) calc(var(--progress) * 100%));
  }

  .audio-card__wave span {
    flex: 1;
    height: var(--h);
    border-radius: 2px;
    background: var(--color-river);
  }

  .audio-card[data-playing] .audio-card__wave span {
    animation: wave-live 900ms var(--ease-in-out) infinite alternate;
  }

  .audio-card[data-playing] .audio-card__wave span:nth-child(3n) {
    animation-delay: -300ms;
  }

  .audio-card[data-playing] .audio-card__wave span:nth-child(3n + 1) {
    animation-delay: -600ms;
  }

  @keyframes wave-live {
    to {
      transform: scaleY(0.6);
    }
  }

  .audio-card__time {
    min-width: 2.5rem;
    color: var(--color-text-on-dark-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- Qué dice ---------- */
  .audio-card__meaning {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-on-dark);
    color: var(--color-text-on-dark);
  }

  .audio-card__label {
    margin-bottom: var(--space-2);
    color: var(--color-river);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }
</style>
