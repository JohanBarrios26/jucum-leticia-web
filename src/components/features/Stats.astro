---
/**
 * BLOQUE: CIFRAS
 * ----------------------------------------------------------------------------
 * Números grandes con su explicación. Solo datos verificados por JUCUM
 * (especificación §35: no inventar estadísticas). Sin cifras, no se muestra.
 */
import type { Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import type { FeatureBlock } from '@/lib/content';

interface Props {
  locale: Locale;
  block: Extract<FeatureBlock, { type: 'stats' }>;
  titleId: string;
}

const { locale, block, titleId } = Astro.props;
const ui = t(locale).features;
---

{
  block.items.length > 0 && (
    <div class="stats">
      <h2 id={titleId} class="visually-hidden">
        {block.title ?? ui.statsTitle}
      </h2>
      <dl class="stats__list">
        {block.items.map((item, i) => (
          <div class="stats__item" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <dt class="stats__label">{item.label}</dt>
            <dd class="stats__value">{item.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  )
}

<style>
  .stats__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-6);
  }

  .stats__item {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 2px solid var(--color-night);
  }

  .stats__value {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h1);
    line-height: 0.9;
  }

  .stats__label {
    color: var(--color-text-muted);
  }
</style>
