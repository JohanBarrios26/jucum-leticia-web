---
/**
 * BLOQUE: ETAPAS (ej. fases de una escuela o momentos de un ministerio)
 * ----------------------------------------------------------------------------
 * Línea de tiempo numerada: horizontal en escritorio, vertical en móvil.
 * La línea se "llena" de azul a medida que se hace scroll.
 */
import PendingContent from '@/components/PendingContent.astro';
import type { Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { showPending } from '@/lib/config';
import type { FeatureBlock } from '@/lib/content';

interface Props {
  locale: Locale;
  block: Extract<FeatureBlock, { type: 'timeline' }>;
  titleId: string;
  /** Texto cuando aún no hay etapas (por defecto: el de las escuelas). */
  pendingText?: string;
}

const { locale, block, titleId, pendingText } = Astro.props;
const ui = t(locale).features;
const hasSteps = block.steps.length > 0;
---

{
  (hasSteps || showPending) && (
    <div class="timeline">
      <div class="timeline__head" data-reveal>
        <h2 id={titleId}>{block.title ?? ui.timelineTitle}</h2>
        {block.intro && <p class="lead">{block.intro}</p>}
      </div>

      {hasSteps ? (
        <ol class="timeline__list" style={`--count: ${block.steps.length}`}>
          {block.steps.map((step, i) => (
            <li class="timeline__step" data-reveal style={`--reveal-delay: ${i * 100}ms`}>
              <span class="timeline__marker" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              {step.label && <span class="timeline__label">{step.label}</span>}
              <h3 class="timeline__title">{step.title}</h3>
              {step.text && <p class="timeline__text">{step.text}</p>}
            </li>
          ))}
        </ol>
      ) : (
        <p class="timeline__pending">
          {pendingText ?? ui.timelinePending} <PendingContent locale={locale} />
        </p>
      )}
    </div>
  )
}

<style>
  .timeline__head {
    display: grid;
    gap: var(--space-4);
    max-width: 44rem;
    margin-bottom: var(--space-7);
  }

  .timeline__head .lead,
  .timeline__pending {
    color: var(--color-text-muted);
  }

  .timeline__list {
    position: relative;
    display: grid;
    gap: var(--space-6);
    padding: 0;
    list-style: none;
  }

  /* Línea de fondo que une las etapas. */
  .timeline__list::before {
    content: '';
    position: absolute;
    top: 1.5rem;
    bottom: 1.5rem;
    left: 1.5rem;
    width: 2px;
    background: linear-gradient(var(--color-river), var(--color-green));
  }

  .timeline__step {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding-left: 4.5rem;
  }

  .timeline__marker {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-night);
    color: var(--color-river);
    font-family: var(--font-display);
    font-size: 1.25rem;
  }

  .timeline__label {
    padding-top: var(--space-2);
    color: var(--color-green);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .timeline__title {
    font-size: var(--text-2xl);
  }

  .timeline__text {
    color: var(--color-text-muted);
  }

  @media (min-width: 64rem) {
    .timeline__list {
      grid-template-columns: repeat(min(var(--count), 4), 1fr);
    }

    .timeline__list::before {
      top: 1.5rem;
      bottom: auto;
      left: 1.5rem;
      right: 1.5rem;
      width: auto;
      height: 2px;
      background: linear-gradient(to right, var(--color-river), var(--color-green));
    }

    .timeline__step {
      padding-left: 0;
      padding-top: 4.5rem;
    }
  }
</style>
