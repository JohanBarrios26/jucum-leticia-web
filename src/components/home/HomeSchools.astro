---
/**
 * INICIO · 5. ESCUELAS / FORMACIÓN (especificación §11)
 * ----------------------------------------------------------------------------
 * Lista editorial: cada escuela es una fila grande (número, sigla, nombre
 * completo, flecha). Lleva a la página individual de la escuela, donde están
 * fechas, requisitos y las PERSONAS ENCARGADAS de esa escuela.
 *
 * Efecto en escritorio (mouse): al pasar sobre una fila aparece la foto de la
 * escuela y sigue al cursor. En pantallas táctiles la foto se ve pequeña
 * dentro de la fila (no hay "hover" en móvil).
 */
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import SmartImage from '@/components/ui/SmartImage.astro';
import { routes, schoolAlternates, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import type { School } from '@/lib/content';

interface Props {
  locale: Locale;
  schools: School[];
}

const { locale, schools } = Astro.props;
const ui = t(locale);
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="schools section surface-sand" aria-labelledby="schools-title" data-schools>
  <div class="container">
    <div class="schools__head">
      <div class="section-head" data-reveal>
        <p class="eyebrow eyebrow--line">{ui.home.schoolsEyebrow}</p>
        <h2 id="schools-title">{ui.home.schoolsTitle}</h2>
      </div>
      <a class="link-arrow" href={routes.schools[locale]} data-reveal>{ui.home.allSchools} <span aria-hidden="true">→</span></a>
    </div>

    <ul role="list" class="schools__list">
      {
        schools.map((s, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <a class="school-row" href={schoolAlternates(s.slug)[locale]} data-school-row={i} data-event="program_card_click">
              <span class="school-row__num">{pad(i + 1)}</span>
              <span class="school-row__thumb" aria-hidden="true">
                {s.image ? <SmartImage image={s.image} decorative sizes="6rem" widths={[240]} /> : <ImagePlaceholder />}
              </span>
              <span class="school-row__name">{s.name}</span>
              <span class="school-row__full">{s.fullName ?? s.description ?? ''}</span>
              <span class="school-row__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Vista previa que sigue al cursor (solo con mouse). Decorativa. -->
  <div class="schools__preview" aria-hidden="true" data-school-preview>
    {
      schools.map((s, i) => (
        <div class="schools__preview-item" data-preview-item={i}>
          {s.image ? <SmartImage image={s.image} decorative sizes="22rem" widths={[480, 768]} /> : <ImagePlaceholder label={pad(i + 1)} />}
        </div>
      ))
    }
  </div>
</section>

<script>
  /*
   * Foto flotante que sigue al cursor sobre la lista de escuelas.
   * Solo se activa con un dispositivo que tenga mouse (hover: hover).
   * El movimiento es suavizado (interpolación) para que se sienta fluido.
   */
  const section = document.querySelector<HTMLElement>('[data-schools]');
  const preview = section?.querySelector<HTMLElement>('[data-school-preview]');
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (section && preview && canHover) {
    const items = preview.querySelectorAll<HTMLElement>('[data-preview-item]');
    let targetX = 0;
    let targetY = 0;
    let x = 0;
    let y = 0;
    let running = false;

    const loop = () => {
      // Se acerca un 15% al cursor en cada cuadro → efecto de "arrastre" suave.
      x += (targetX - x) * 0.15;
      y += (targetY - y) * 0.15;
      preview.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;
      if (preview.hasAttribute('data-active')) requestAnimationFrame(loop);
      else running = false;
    };

    section.querySelectorAll<HTMLElement>('[data-school-row]').forEach((row) => {
      row.addEventListener('mouseenter', () => {
        items.forEach((item) => item.toggleAttribute('data-show', item.dataset.previewItem === row.dataset.schoolRow));
        preview.setAttribute('data-active', '');
        if (!running) {
          running = true;
          requestAnimationFrame(loop);
        }
      });
      row.addEventListener('mouseleave', () => preview.removeAttribute('data-active'));
    });

    section.addEventListener('mousemove', (e) => {
      targetX = e.clientX;
      targetY = e.clientY;
    });

    // Primera posición sin animación, para que no "vuele" desde la esquina.
    section.addEventListener('mouseenter', (e) => {
      x = targetX = e.clientX;
      y = targetY = e.clientY;
    });
  }
</script>

<style>
  .schools {
    position: relative;
  }

  .schools__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }

  .schools__head .section-head {
    margin-bottom: 0;
  }

  .schools__list {
    border-top: 1px solid rgb(16 42 42 / 0.2);
  }

  .schools__list li {
    border-bottom: 1px solid rgb(16 42 42 / 0.2);
  }

  /* ---------- Fila ---------- */
  .school-row {
    position: relative;
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    grid-template-areas:
      'num thumb name arrow'
      'num thumb full arrow';
    align-items: center;
    column-gap: var(--space-5);
    padding-block: var(--space-5);
    color: var(--color-night);
    text-decoration: none;
    isolation: isolate;
  }

  /* Fondo oscuro que "sube" al pasar el mouse. */
  .school-row::before {
    content: '';
    position: absolute;
    inset: 0 calc(-1 * var(--space-4));
    z-index: -1;
    border-radius: var(--radius);
    background: var(--color-night);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 500ms var(--ease);
  }

  .school-row:hover::before,
  .school-row:focus-visible::before {
    transform: scaleY(1);
  }

  .school-row:hover,
  .school-row:focus-visible {
    color: var(--color-cloud);
  }

  .school-row__num {
    grid-area: num;
    align-self: start;
    padding-top: 0.6em;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-green);
    transition: color var(--duration) var(--ease);
  }

  .school-row:hover .school-row__num {
    color: var(--color-river);
  }

  .school-row__thumb {
    grid-area: thumb;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .school-row__thumb :global(img),
  .school-row__thumb :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .school-row__name {
    grid-area: name;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.5rem + 3.5vw, 4.5rem);
    line-height: 0.9;
    text-transform: uppercase;
    transition: transform 500ms var(--ease);
  }

  .school-row:hover .school-row__name {
    transform: translateX(0.75rem);
  }

  .school-row__full {
    grid-area: full;
    margin-top: var(--space-2);
    color: inherit;
    opacity: 0.7;
    font-size: var(--text-sm);
  }

  .school-row__arrow {
    grid-area: arrow;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 1.25rem;
    transition:
      transform 400ms var(--ease),
      background-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .school-row:hover .school-row__arrow {
    background: var(--color-river);
    border-color: var(--color-river);
    color: var(--color-night);
    transform: rotate(-45deg);
  }

  /* Con mouse: se oculta la miniatura (la foto flotante la reemplaza). */
  @media (hover: hover) and (pointer: fine) {
    .school-row {
      grid-template-columns: 3rem 1fr auto;
      grid-template-areas:
        'num name arrow'
        'num full arrow';
    }

    .school-row__thumb {
      display: none;
    }
  }

  @media (max-width: 36rem) {
    .school-row {
      column-gap: var(--space-3);
    }

    .school-row__thumb {
      width: 3.25rem;
      height: 3.25rem;
    }

    .school-row__arrow {
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  /* ---------- Foto flotante ---------- */
  .schools__preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 10;
    width: clamp(16rem, 22vw, 22rem);
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    scale: 0.85;
    box-shadow: var(--shadow-lg);
    transition:
      opacity 300ms var(--ease),
      scale 400ms var(--ease);
  }

  .schools__preview[data-active] {
    opacity: 1;
    scale: 1;
  }

  .schools__preview-item {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 300ms var(--ease);
  }

  .schools__preview-item[data-show] {
    opacity: 1;
  }

  .schools__preview-item :global(img),
  .schools__preview-item :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (hover: none), (pointer: coarse) {
    .schools__preview {
      display: none;
    }
  }
</style>
