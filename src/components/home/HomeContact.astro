---
/**
 * INICIO · 11. CONTACTO (especificación §16)
 * ----------------------------------------------------------------------------
 * "Comienza una conversación": canales directos en tarjetas grandes
 * (WhatsApp, correo, teléfonos). El formulario de contacto se construye en la
 * fase 5 (necesita un servicio de envío y protección contra spam) y vivirá en
 * la página /contacto/.
 *
 * Todos los datos vienen de la configuración global (getSiteSettings).
 */
import { routes, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { whatsappUrl, type SiteSettings } from '@/lib/content';

interface Props {
  locale: Locale;
  settings: SiteSettings;
}

const { locale, settings } = Astro.props;
const ui = t(locale);
---

<section class="contact section" aria-labelledby="contact-title">
  <div class="container contact__grid">
    <div class="contact__intro">
      <p class="eyebrow eyebrow--line contact__eyebrow" data-reveal>{ui.home.contactEyebrow}</p>
      <h2 id="contact-title" data-reveal style="--reveal-delay: 80ms">{ui.home.contactTitle}</h2>
      <p class="lead contact__text" data-reveal style="--reveal-delay: 160ms">{ui.home.contactText}</p>
      <a class="link-arrow contact__more" href={routes.contact[locale]} data-reveal style="--reveal-delay: 200ms">
        {ui.nav.contact} <span aria-hidden="true">→</span>
      </a>
    </div>

    <ul role="list" class="contact__channels">
      {
        settings.whatsapp && (
          <li data-reveal>
            <a
              class="channel channel--primary"
              href={whatsappUrl(settings.whatsapp, ui.contact.whatsappMessage)}
              target="_blank"
              rel="noopener"
              data-event="whatsapp_click"
            >
              <span class="channel__label">{ui.contact.whatsapp}</span>
              <span class="channel__value">{ui.contact.writeWhatsapp}</span>
              <span class="channel__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        )
      }
      <li data-reveal style="--reveal-delay: 80ms">
        <a class="channel" href={`mailto:${settings.email}`} data-event="email_click">
          <span class="channel__label">{ui.contact.email}</span>
          <span class="channel__value">{settings.email}</span>
          <span class="channel__arrow" aria-hidden="true">→</span>
        </a>
      </li>
      {
        settings.phones.map((phone, i) => (
          <li data-reveal style={`--reveal-delay: ${160 + i * 80}ms`}>
            <a class="channel" href={phone.href} data-event="phone_click">
              <span class="channel__label">
                {ui.contact.phone} · {phone.label}
              </span>
              <span class="channel__value">{phone.number}</span>
              <span class="channel__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 64rem) {
    .contact__grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .contact__eyebrow {
    color: var(--color-green);
  }

  .contact__intro h2 {
    margin-top: var(--space-4);
  }

  .contact__text {
    max-width: 30rem;
    margin-top: var(--space-5);
    color: var(--color-text-muted);
  }

  .contact__more {
    margin-top: var(--space-6);
  }

  .contact__channels {
    display: grid;
    gap: var(--space-3);
  }

  /* ---------- Tarjeta de canal ---------- */
  .channel {
    position: relative;
    display: grid;
    gap: var(--space-1);
    padding: var(--space-5) var(--space-8) var(--space-5) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-white);
    color: var(--color-night);
    text-decoration: none;
    transition:
      border-color var(--duration) var(--ease),
      transform 400ms var(--ease),
      box-shadow 400ms var(--ease);
  }

  .channel:hover {
    border-color: var(--color-green);
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .channel--primary {
    background: var(--color-night);
    border-color: var(--color-night);
    color: var(--color-cloud);
  }

  .channel--primary:hover {
    border-color: var(--color-river);
  }

  .channel__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-green);
  }

  .channel--primary .channel__label {
    color: var(--color-river);
  }

  .channel__value {
    font-size: var(--text-xl);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .channel__arrow {
    position: absolute;
    top: 50%;
    right: var(--space-5);
    font-size: 1.25rem;
    transform: translateY(-50%);
    transition: transform 400ms var(--ease);
  }

  .channel:hover .channel__arrow {
    transform: translate(4px, -50%);
  }
</style>
