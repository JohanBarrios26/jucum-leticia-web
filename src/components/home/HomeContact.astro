---
/**
 * INICIO · 11. CONTACTO (especificación §16)
 * ----------------------------------------------------------------------------
 * "Comienza una conversación": texto de invitación + canales directos
 * (ContactChannels.astro). El formulario completo está en /contacto/.
 *
 * Todos los datos vienen de la configuración global (getSiteSettings).
 */
import ContactChannels from '@/components/ContactChannels.astro';
import { routes, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import type { SiteSettings } from '@/lib/content';

interface Props {
  locale: Locale;
  settings: SiteSettings;
}

const { locale, settings } = Astro.props;
const ui = t(locale);
---

<section class="contact section" aria-labelledby="contact-title">
  <div class="container contact__grid">
    <div class="contact__intro">
      <p class="eyebrow eyebrow--line contact__eyebrow" data-reveal>{ui.home.contactEyebrow}</p>
      <h2 id="contact-title" data-reveal style="--reveal-delay: 80ms">{ui.home.contactTitle}</h2>
      <p class="lead contact__text" data-reveal style="--reveal-delay: 160ms">{ui.home.contactText}</p>
      <a class="link-arrow contact__more" href={routes.contact[locale]} data-reveal style="--reveal-delay: 200ms">
        {ui.nav.contact} <span aria-hidden="true">→</span>
      </a>
    </div>

    <ContactChannels locale={locale} settings={settings} />
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 64rem) {
    .contact__grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .contact__eyebrow {
    color: var(--color-green);
  }

  .contact__intro h2 {
    margin-top: var(--space-4);
  }

  .contact__text {
    max-width: 30rem;
    margin-top: var(--space-5);
    color: var(--color-text-muted);
  }

  .contact__more {
    margin-top: var(--space-6);
  }

</style>
