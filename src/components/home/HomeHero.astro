---
/**
 * INICIO · 1. HERO (especificación §5)
 * ----------------------------------------------------------------------------
 * Foto a pantalla completa + título grande + dos botones.
 * En los primeros segundos debe quedar claro: quién es JUCUM Leticia, dónde
 * está, su orientación misionera y que se puede participar.
 *
 * Animaciones (solo CSS, sin JavaScript):
 *   - La foto hace un zoom lento hacia atrás ("Ken Burns").
 *   - Cada línea del título sube desde abajo, una tras otra.
 *   - Descripción, botones y barra inferior aparecen después.
 *
 * Textos e imagen vienen de getHome().hero → editables desde el panel.
 */
import SmartImage from '@/components/ui/SmartImage.astro';
import { routes, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import type { Home } from '@/lib/content';

interface Props {
  locale: Locale;
  hero: Home['hero'];
}

const { locale, hero } = Astro.props;
const ui = t(locale);
const lastLine = hero.titleLines.length - 1;
---

<section class="hero on-photo" aria-labelledby="hero-title">
  <div class="hero__media">
    <SmartImage image={hero.image} priority sizes="100vw" class="hero__img" />
  </div>

  <div class="container hero__content">
    <p class="eyebrow eyebrow--line hero__eyebrow hero__fade" style="--d: 100ms">{hero.eyebrow}</p>

    <h1 class="hero__title" id="hero-title">
      {
        hero.titleLines.map((line, i) => (
          <span class="hero__line">
            <span class:list={['hero__line-inner', { accent: i === lastLine }]} style={`--i: ${i}`}>
              {line}
            </span>
          </span>
        ))
      }
    </h1>

    <div class="hero__bottom">
      <p class="lead hero__description hero__fade" style="--d: 700ms">{hero.description}</p>

      <div class="hero__actions hero__fade" style="--d: 850ms">
        <a class="btn btn--primary" href={routes.join[locale]} data-event="cta_join_click">
          {hero.primaryCta} <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--outline" href={routes.about[locale]}>
          {hero.secondaryCta} <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Barra inferior: indicador de scroll y coordenadas reales de Leticia. -->
  <div class="container hero__meta hero__fade" style="--d: 1100ms" aria-hidden="true">
    <span class="hero__scroll"><span class="hero__scroll-line"></span>{ui.home.scroll}</span>
    <span class="hero__coords">4°12′S · 69°56′W — {ui.home.coordinates}</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100svh;
    min-height: max(34rem, 100svh);
    padding-top: calc(var(--header-height) + var(--space-7));
    color: var(--color-text-on-dark);
    background: var(--color-night-deep);
    overflow: hidden;
    isolation: isolate;
  }

  /* ---------- Foto de fondo ---------- */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__media :global(img),
  .hero__media :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
  }

  .hero__media :global(img) {
    animation: kenburns 18s var(--ease) both;
  }

  /* Degradados para que el texto siempre sea legible sobre cualquier foto. */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(10 29 29 / 0.92) 0%, rgb(10 29 29 / 0.35) 45%, rgb(10 29 29 / 0.15) 70%, rgb(10 29 29 / 0.5) 100%),
      linear-gradient(to right, rgb(10 29 29 / 0.55) 0%, transparent 65%);
  }

  @keyframes kenburns {
    from {
      transform: scale(1.14);
    }
    to {
      transform: scale(1);
    }
  }

  /* ---------- Textos ---------- */
  .hero__content {
    padding-bottom: var(--space-7);
  }

  .hero__eyebrow {
    color: var(--color-river);
  }

  .hero__title {
    margin-top: var(--space-5);
    font-size: var(--text-display);
    line-height: 0.88;
  }

  /* Cada línea es una "ventana" (overflow hidden) por donde sube el texto. */
  .hero__line {
    display: block;
    overflow: hidden;
    /* Espacio extra arriba para que no se corten las tildes (Ó, Á...). */
    padding-top: 0.14em;
    margin-top: -0.14em;
    padding-bottom: 0.04em;
  }

  .hero__line-inner {
    display: block;
    animation: line-up 1100ms var(--ease) both;
    animation-delay: calc(250ms + var(--i) * 130ms);
  }

  @keyframes line-up {
    from {
      transform: translateY(105%);
    }
  }

  .hero__bottom {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  @media (min-width: 64rem) {
    .hero__bottom {
      grid-template-columns: minmax(0, 32rem) auto;
      justify-content: space-between;
      align-items: end;
    }
  }

  .hero__description {
    max-width: 32rem;
    color: var(--color-text-on-dark);
    opacity: 0.9;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Aparición retrasada (--d) de los elementos secundarios. */
  .hero__fade {
    animation: fade-up 900ms var(--ease) both;
    animation-delay: var(--d, 0ms);
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  /* ---------- Barra inferior ---------- */
  .hero__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border-on-dark);
    color: var(--color-text-on-dark-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Línea que "fluye" hacia abajo, invitando a hacer scroll. */
  .hero__scroll-line {
    position: relative;
    width: 2.5rem;
    height: 1px;
    background: rgb(255 255 255 / 0.25);
    overflow: hidden;
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-river);
    animation: flow 2.2s var(--ease-in-out) infinite;
  }

  @keyframes flow {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(100%);
    }
  }

  @media (max-width: 40rem) {
    .hero__coords {
      display: none;
    }

    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
