---
/**
 * INICIO · ALCANCE (mapa de iglesias en la triple frontera)
 * ----------------------------------------------------------------------------
 * Muestra el mapa ilustrado de las comunidades donde JUCUM Leticia ha plantado
 * iglesias (src/components/AmazonMap.astro) en tamaño grande, junto a una
 * tarjeta con la cifra de iglesias. A propósito NO muestra la lista de
 * comunidades: esa solo está en la página del ministerio, para dejar
 * curiosidad por conocer más.
 *
 * Distribución (para que el inicio no quede tan largo):
 *   - Escritorio: tarjeta (cifra + botón) a la izquierda y mapa a la derecha.
 *   - Celular: cifra y frase en una fila, luego el mapa y el botón.
 *
 * De dónde sale cada cosa:
 *   - Puntos del mapa: panel → "Mapa: comunidades".
 *   - La cifra grande: el bloque "Cifras" del ministerio que tiene activado
 *     "Mostrar el mapa de comunidades" (hoy: 116 iglesias). Si no hay, no se muestra.
 *   - Textos fijos y botón: ui.ts (reach.*).
 * Si no hay comunidades cargadas, la sección no se muestra.
 */
import AmazonMap from '@/components/AmazonMap.astro';
import { ministryAlternates, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import type { Community, Ministry } from '@/lib/content';

interface Props {
  locale: Locale;
  communities: Community[];
  /** Ministerio que muestra el mapa (para el botón y la cifra). */
  ministry?: Ministry;
}

const { locale, communities, ministry } = Astro.props;
const ui = t(locale).reach;

// Primera cifra del ministerio (ej. "116" · "Iglesias plantadas y construidas…").
const statsBlock = ministry?.features.find((f) => f.type === 'stats');
const stat = statsBlock && 'items' in statsBlock ? statsBlock.items[0] : undefined;
---

{
  communities.length > 0 && (
    <section class="reach section surface-deep" aria-labelledby="reach-title">
      <div class="container reach__wide">
        <h2 id="reach-title" class="visually-hidden">{ui.title}</h2>

        <div class="reach__layout">
          <div class="reach__card" data-reveal>
            <div class="reach__head">
              <p class="eyebrow eyebrow--line reach__eyebrow">{ui.eyebrow}</p>
              {
                stat && (
                  <p class="reach__stat">
                    <span class="reach__num" data-count={stat.value}>{stat.value}</span>
                    <span class="reach__label">{stat.label}</span>
                  </p>
                )
              }
            </div>

            <svg class="reach__wave" viewBox="0 0 160 12" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <path d="M0 6C13 0 27 12 40 6S67 0 80 6s27 6 40 0 27-6 40 0" />
            </svg>

            {
              ministry && (
                <div class="reach__cta">
                  <a class="btn btn--primary btn--lg" href={ministryAlternates(ministry.slug)[locale]} data-event="reach_cta_click">
                    <span>{ui.cta}</span> <span class="btn__arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              )
            }
          </div>

          <div class="reach__map">
            <AmazonMap locale={locale} communities={communities} titleId="reach-title" large showList={false} />
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  /*
   * La cifra "cuenta" desde 0 hasta su valor cuando llega a la pantalla.
   * Sin JavaScript, o con "reducir movimiento", se ve el número final.
   */
  const num = document.querySelector<HTMLElement>('.reach__num[data-count]');
  const target = Number(num?.dataset.count);
  if (num && Number.isFinite(target) && target > 0 && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    num.textContent = '0';
    const observer = new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting) return;
      observer.disconnect();
      const start = performance.now();
      const duration = 1800;
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / duration);
        num.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, { threshold: 0.6 });
    observer.observe(num);
  }
</script>

<style>
  .reach {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(60rem 34rem at 12% 40%, rgb(0 173 239 / 0.26), transparent 62%),
      radial-gradient(60rem 32rem at 100% 100%, rgb(31 106 86 / 0.5), transparent 60%),
      var(--color-night-deep);
  }

  /* Casi todo el ancho de la pantalla, para que el mapa sea lo más grande posible. */
  .reach__wide {
    position: relative;
    max-width: 120rem;
  }

  /* ---------- Distribución ---------- */
  .reach__layout {
    display: grid;
    gap: var(--space-5);
    grid-template-areas:
      'head'
      'map'
      'cta';
  }

  .reach__map {
    grid-area: map;
    min-width: 0;
  }

  /* Celular: la tarjeta "desaparece" y sus partes se reparten en la cuadrícula. */
  .reach__card {
    display: contents;
  }

  .reach__head {
    grid-area: head;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: var(--space-4);
    row-gap: var(--space-2);
  }

  .reach__eyebrow {
    grid-column: 1 / -1;
    color: var(--color-river);
  }

  .reach__stat {
    display: contents;
  }

  .reach__wave {
    display: none;
  }

  .reach__cta {
    grid-area: cta;
  }

  /* ---------- Cifra ---------- */
  .reach__num {
    font-family: var(--font-display);
    font-size: clamp(6rem, 24vw, 8.5rem);
    line-height: 0.82;
    letter-spacing: 0.01em;
    background: linear-gradient(180deg, #ffffff 0%, var(--color-river) 55%, #0a7fb0 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 2rem rgb(0 173 239 / 0.55));
    font-variant-numeric: tabular-nums;
  }

  .reach__label {
    color: var(--color-text-on-dark);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  /* ---------- Botón ---------- */
  .reach__cta :global(.btn) {
    width: 100%;
    min-height: 3.5rem;
    justify-content: space-between;
    padding-inline: var(--space-6);
    font-size: var(--text-base);
  }

  /* ---------- Escritorio: tarjeta a la izquierda, mapa a la derecha ---------- */
  @media (min-width: 64rem) {
    .reach__layout {
      grid-template-columns: minmax(19rem, 0.36fr) 1fr;
      grid-template-areas: 'card map';
      align-items: center;
      column-gap: var(--space-7);
    }

    .reach__card {
      grid-area: card;
      display: grid;
      gap: var(--space-5);
      padding: var(--space-7) var(--space-6);
      border: 1px solid rgb(255 255 255 / 0.16);
      border-radius: var(--radius-lg);
      background: linear-gradient(165deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.02) 70%);
      box-shadow:
        0 1.5rem 3rem rgb(0 0 0 / 0.35),
        inset 0 1px 0 rgb(255 255 255 / 0.12);
      container-type: inline-size;
      text-align: center;
    }

    .reach__head {
      grid-area: auto;
      grid-template-columns: 1fr;
      justify-items: center;
      row-gap: var(--space-3);
    }

    .reach__eyebrow {
      grid-column: auto;
    }

    .reach__stat {
      display: grid;
      justify-items: center;
      gap: var(--space-4);
    }

    /* La cifra ocupa el ancho de la tarjeta, sea cual sea la pantalla. */
    .reach__num {
      font-size: clamp(6.5rem, 66cqi, 15rem);
    }

    .reach__label {
      max-width: 22rem;
      font-size: var(--text-base);
    }

    .reach__wave {
      display: block;
      width: 100%;
      height: 0.75rem;
      fill: none;
      stroke: var(--color-river);
      stroke-width: 2;
      stroke-linecap: round;
      opacity: 0.7;
    }

    .reach__wave path {
      vector-effect: non-scaling-stroke;
    }

    .reach__cta {
      grid-area: auto;
    }
  }
</style>
