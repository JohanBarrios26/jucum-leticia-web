---
/**
 * INICIO · ALCANCE (mapa de iglesias en la triple frontera)
 * ----------------------------------------------------------------------------
 * Muestra el mapa ilustrado de las comunidades donde JUCUM Leticia ha plantado
 * iglesias (src/components/AmazonMap.astro) en tamaño grande, con la cifra de
 * iglesias bien visible. A propósito NO muestra la lista de comunidades: esa
 * solo está en la página del ministerio, para dejar curiosidad por conocer más.
 *
 * De dónde sale cada cosa:
 *   - Puntos del mapa: panel → "Mapa: comunidades".
 *   - La cifra grande: el bloque "Cifras" del ministerio que tiene activado
 *     "Mostrar el mapa de comunidades" (hoy: 116 iglesias). Si no hay, no se muestra.
 *   - Textos fijos: ui.ts (reach.*).
 * Si no hay comunidades cargadas, la sección no se muestra.
 */
import AmazonMap from '@/components/AmazonMap.astro';
import { ministryAlternates, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import type { Community, Ministry } from '@/lib/content';

interface Props {
  locale: Locale;
  communities: Community[];
  /** Ministerio que muestra el mapa (para el botón y la cifra). */
  ministry?: Ministry;
}

const { locale, communities, ministry } = Astro.props;
const ui = t(locale).reach;

// Primera cifra del ministerio (ej. "116" · "Iglesias plantadas y construidas…").
const statsBlock = ministry?.features.find((f) => f.type === 'stats');
const stat = statsBlock && 'items' in statsBlock ? statsBlock.items[0] : undefined;
---

{
  communities.length > 0 && (
    <section class="reach section surface-deep" aria-labelledby="reach-title">
      <div class="reach__glow" aria-hidden="true" />
      <div class="container reach__wide">
        <h2 id="reach-title" class="visually-hidden">{ui.title}</h2>

        <div class="reach__head" data-reveal>
          <p class="eyebrow eyebrow--line reach__eyebrow">{ui.eyebrow}</p>
          {
            stat && (
              <p class="reach__stat">
                <span class="reach__num" data-count={stat.value}>{stat.value}</span>
                <span class="reach__label">{stat.label}</span>
              </p>
            )
          }
        </div>

        <AmazonMap locale={locale} communities={communities} titleId="reach-title" large showList={false} />

        {
          ministry && (
            <div class="reach__cta" data-reveal>
              <a class="btn btn--primary btn--lg" href={ministryAlternates(ministry.slug)[locale]} data-event="reach_cta_click">
                {ui.cta} <span class="btn__arrow" aria-hidden="true">→</span>
              </a>
            </div>
          )
        }
      </div>
    </section>
  )
}

<script>
  /*
   * La cifra "cuenta" desde 0 hasta su valor cuando llega a la pantalla.
   * Sin JavaScript, o con "reducir movimiento", se ve el número final.
   */
  const num = document.querySelector<HTMLElement>('.reach__num[data-count]');
  const target = Number(num?.dataset.count);
  if (num && Number.isFinite(target) && target > 0 && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    num.textContent = '0';
    const observer = new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting) return;
      observer.disconnect();
      const start = performance.now();
      const duration = 1800;
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / duration);
        num.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, { threshold: 0.6 });
    observer.observe(num);
  }
</script>

<style>
  .reach {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(70rem 36rem at 50% 0%, rgb(0 173 239 / 0.28), transparent 60%),
      radial-gradient(60rem 32rem at 100% 100%, rgb(31 106 86 / 0.5), transparent 60%),
      var(--color-night-deep);
  }

  /* Casi todo el ancho de la pantalla, para que el mapa sea lo más grande posible. */
  .reach__wide {
    position: relative;
    max-width: 120rem;
  }

  .reach__head {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    text-align: center;
  }

  .reach__eyebrow {
    color: var(--color-river);
  }

  .reach__stat {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-3);
  }

  /* Halo que late detrás de la cifra. */
  .reach__stat::before {
    content: '';
    position: absolute;
    top: 42%;
    left: 50%;
    width: min(90vw, 38rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(0 173 239 / 0.45), transparent 68%);
    transform: translate(-50%, -50%);
    filter: blur(8px);
    animation: reach-pulse 3.2s ease-in-out infinite alternate;
    pointer-events: none;
  }

  @keyframes reach-pulse {
    from {
      opacity: 0.55;
      transform: translate(-50%, -50%) scale(0.9);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.1);
    }
  }

  .reach__num {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(8.5rem, 27vw, 19rem);
    line-height: 0.82;
    letter-spacing: 0.01em;
    background: linear-gradient(180deg, #ffffff 0%, var(--color-river) 55%, #0a7fb0 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 2.5rem rgb(0 173 239 / 0.55));
    font-variant-numeric: tabular-nums;
  }

  .reach__label {
    position: relative;
    max-width: 46rem;
    color: var(--color-text-on-dark);
    font-size: var(--text-base);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .reach__cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-7);
  }

  .reach :global(.btn--lg) {
    min-height: 3.5rem;
    padding-inline: var(--space-7);
    font-size: var(--text-base);
  }

  @media (prefers-reduced-motion: reduce) {
    .reach__stat::before {
      animation: none;
    }
  }
</style>
