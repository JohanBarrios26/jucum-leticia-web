---
/**
 * INICIO · 8. GALERÍA (especificación §14)
 * ----------------------------------------------------------------------------
 * Vitrina grande de la misión en imágenes: un mosaico ("bento") con las fotos
 * marcadas como "Destacada en el inicio" en el panel, y una última tarjeta
 * que invita a ver TODA la galería (/galeria/).
 *
 * - Si no hay fotos destacadas, se usan las primeras de la galería.
 * - El patrón del mosaico se repite cada 6 tarjetas (cuadrícula de 4×3):
 *   1 grande · 2 normales · 1 alta · 1 ancha · 1 alta (la última es la tarjeta
 *   "ver toda la galería"). Por eso lo ideal son 11 fotos destacadas.
 *   Orden recomendado: 1.ª y 7.ª horizontales (ocupan el doble), 4.ª, 6.ª y
 *   10.ª verticales o centradas, 5.ª panorámica.
 * - Al pasar el mouse la foto se acerca y aparece su título.
 */
import SmartImage from '@/components/ui/SmartImage.astro';
import { routes, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import type { GalleryItem } from '@/lib/content';

interface Props {
  locale: Locale;
  items: GalleryItem[];
}

const { locale, items } = Astro.props;
const ui = t(locale);

const MAX = 11;
const featured = items.filter((i) => i.featured);
const shown = (featured.length > 0 ? featured : items).slice(0, MAX);
const rest = items.length - shown.length;
// Foto de fondo de la tarjeta final: la primera que no está en el mosaico.
const ctaImage = (items.find((i) => !shown.includes(i)) ?? items[items.length - 1])?.image;
---

{
  items.length > 0 && (
    <section class="hg section surface-deep" aria-labelledby="gallery-title">
      <div class="container">
        <div class="hg__head" data-reveal>
          <div class="section-head">
            <p class="eyebrow eyebrow--line">{ui.home.galleryEyebrow}</p>
            <h2 id="gallery-title" class="hg__title">{ui.home.galleryTitle}</h2>
            <p class="hg__lead">{ui.gallery.pageLead}</p>
          </div>
          <a class="btn btn--primary" href={routes.gallery[locale]} data-event="gallery_see_all_click">
            {ui.gallery.seeAll} <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>

        <ul role="list" class="hg__grid">
          {shown.map((item, i) => (
            <li class="hg__item" data-reveal="scale" style={`--reveal-delay: ${(i % 4) * 80}ms`}>
              <figure class="hg__link">
                <SmartImage image={item.image} sizes="(min-width: 64rem) 40vw, 100vw" widths={[480, 768, 1080, 1440]} />
                <span class="hg__caption">
                  <span class="hg__tag">{ui.gallery.categories[item.category]}</span>
                  {item.title && <span class="hg__name">{item.title}</span>}
                </span>
              </figure>
            </li>
          ))}
          <li class="hg__item hg__item--cta" data-reveal="scale" style="--reveal-delay: 320ms">
            <a class="hg__link hg__cta" href={routes.gallery[locale]} data-event="gallery_cta_click">
              {ctaImage && <SmartImage image={ctaImage} decorative sizes="25vw" widths={[480, 768]} />}
              <span class="hg__cta-body">
                {rest > 0 && <span class="hg__cta-number">+{rest}</span>}
                <span class="hg__cta-text">{rest > 0 ? ui.gallery.morePhotos : ui.gallery.seeAll}</span>
                <span class="hg__cta-arrow" aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        </ul>
      </div>
    </section>
  )
}

<style>
  .hg {
    overflow: clip;
  }

  .hg__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-5);
    margin-bottom: var(--space-7);
  }

  .hg__head .section-head {
    margin-bottom: 0;
    max-width: 44rem;
  }

  .hg__lead {
    color: var(--color-text-on-dark-muted);
    max-width: 38rem;
  }

  .hg__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: clamp(8rem, 36vw, 13rem);
    grid-auto-flow: dense;
    gap: clamp(0.5rem, 1.2vw, 1rem);
  }

  @media (min-width: 48rem) {
    .hg__grid {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: clamp(7rem, min(11vw, 19svh), 11rem);
    }

    /* Patrón del mosaico (se repite cada 6 tarjetas y llena una cuadrícula de 4×3). */
    .hg__item:nth-child(6n + 1) {
      grid-column: span 2;
      grid-row: span 2;
    }

    .hg__item:nth-child(6n + 4),
    .hg__item:nth-child(6n + 6) {
      grid-row: span 2;
    }

    .hg__item:nth-child(6n + 5) {
      grid-column: span 2;
    }
  }

  @media (max-width: 47.99rem) {
    .hg__item:nth-child(3n + 1) {
      grid-column: span 2;
    }
  }

  .hg__item {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-night);
  }

  .hg__link {
    margin: 0;
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }

  .hg__item :global(img),
  .hg__item :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease);
  }

  .hg__item:hover :global(img),
  .hg__link:focus-visible :global(img) {
    transform: scale(1.07);
  }

  .hg__caption {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: 0.15rem;
    padding: var(--space-8) var(--space-4) var(--space-4);
    background: linear-gradient(to top, rgb(10 29 29 / 0.88), transparent);
    color: var(--color-cloud);
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 400ms var(--ease),
      transform 400ms var(--ease);
  }

  .hg__item:hover .hg__caption,
  .hg__link:focus-visible .hg__caption {
    opacity: 1;
    transform: none;
  }

  .hg__tag {
    color: var(--color-river);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .hg__name {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.25;
  }

  /* En pantallas táctiles el título se ve siempre (no hay hover). */
  @media (hover: none) {
    .hg__caption {
      opacity: 1;
      transform: none;
    }

    .hg__tag {
      display: none;
    }
  }

  /* ---------- Tarjeta final: "ver toda la galería" ---------- */
  .hg__cta :global(img) {
    filter: saturate(0.8);
  }

  .hg__cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(160deg, rgb(0 173 239 / 0.82), rgb(10 29 29 / 0.88));
    transition: opacity 400ms var(--ease);
  }

  .hg__cta-body {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--space-2);
    padding: var(--space-4);
    color: var(--color-cloud);
    text-align: center;
  }

  .hg__cta-number {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1;
  }

  .hg__cta-text {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .hg__cta-arrow {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-top: var(--space-2);
    border: 1px solid rgb(255 255 255 / 0.6);
    border-radius: 50%;
    font-size: 1.25rem;
    transition:
      background-color var(--duration) var(--ease),
      color var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .hg__cta:hover .hg__cta-arrow,
  .hg__cta:focus-visible .hg__cta-arrow {
    background: var(--color-cloud);
    color: var(--color-night);
    transform: translateX(0.25rem);
  }
</style>
