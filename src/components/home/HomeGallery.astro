---
/**
 * INICIO · 8. GALERÍA (especificación §14)
 * ----------------------------------------------------------------------------
 * Mosaico de fotos ("bento"): tamaños distintos para dar ritmo. Al pasar el
 * mouse la foto se acerca y aparece su título.
 *
 * Las fotos vienen de getGallery() (solo las marcadas como publicables).
 * El patrón del mosaico se repite cada 6 fotos; si JUCUM agrega más, el
 * mosaico sigue creciendo solo.
 */
import SmartImage from '@/components/ui/SmartImage.astro';
import type { Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import type { GalleryItem } from '@/lib/content';

interface Props {
  locale: Locale;
  items: GalleryItem[];
}

const { locale, items } = Astro.props;
const ui = t(locale);
---

{
  items.length > 0 && (
    <section class="gallery section" aria-labelledby="gallery-title">
      <div class="container">
        <div class="section-head" data-reveal>
          <p class="eyebrow eyebrow--line">{ui.home.galleryEyebrow}</p>
          <h2 id="gallery-title">{ui.home.galleryTitle}</h2>
        </div>

        <ul role="list" class="gallery__grid">
          {items.map((item, i) => (
            <li class="gallery__item" data-reveal="scale" style={`--reveal-delay: ${(i % 3) * 90}ms`}>
              <figure>
                <SmartImage image={item.image} sizes="(min-width: 64rem) 40vw, 100vw" widths={[480, 768, 1080, 1440]} />
                {item.title && <figcaption>{item.title}</figcaption>}
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .gallery {
    padding-top: 0;
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: clamp(9rem, 22vw, 17rem);
    grid-auto-flow: dense;
    gap: clamp(0.5rem, 1.2vw, 1rem);
  }

  @media (min-width: 48rem) {
    .gallery__grid {
      grid-template-columns: repeat(4, 1fr);
    }

    /* Patrón del mosaico (se repite cada 6 fotos y llena una cuadrícula de 4×3). */
    .gallery__item:nth-child(6n + 1) {
      grid-column: span 2;
      grid-row: span 2;
    }

    .gallery__item:nth-child(6n + 4),
    .gallery__item:nth-child(6n + 6) {
      grid-row: span 2;
    }

    .gallery__item:nth-child(6n + 5) {
      grid-column: span 2;
    }
  }

  @media (max-width: 47.99rem) {
    .gallery__item:nth-child(3n + 1) {
      grid-column: span 2;
    }
  }

  .gallery__item figure {
    position: relative;
    height: 100%;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .gallery__item :global(img),
  .gallery__item :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease);
  }

  .gallery__item figure:hover :global(img) {
    transform: scale(1.06);
  }

  .gallery__item figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--space-6) var(--space-4) var(--space-4);
    background: linear-gradient(to top, rgb(10 29 29 / 0.8), transparent);
    color: var(--color-cloud);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 400ms var(--ease),
      transform 400ms var(--ease);
  }

  .gallery__item figure:hover figcaption {
    opacity: 1;
    transform: none;
  }

  /* En pantallas táctiles el título se ve siempre (no hay hover). */
  @media (hover: none) {
    .gallery__item figcaption {
      opacity: 1;
      transform: none;
    }
  }
</style>
