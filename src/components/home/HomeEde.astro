---
/**
 * INICIO · EDE – ESCUELA DE DISCIPULADO Y ENTRENAMIENTO
 * ----------------------------------------------------------------------------
 * Sección destacada de la EDE, la escuela que es la puerta para ser parte de
 * JUCUM. Reemplaza a la antigua sección de OBT (OBT sigue en Ministerios).
 *
 * De dónde sale cada cosa:
 *   - Foto y nombre: la escuela "EDE" del panel (Escuelas).
 *   - Las dos fases (teórica y práctica): el bloque "Etapas" de esa escuela.
 *   - Textos fijos y frase de invitación: ui.ts (home.ede*).
 * Botones: "Conocer la EDE" (página de la escuela) y "Quiero estudiar la EDE"
 * (formulario de contacto con el motivo "Quiero estudiar" ya elegido).
 */
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import SmartImage from '@/components/ui/SmartImage.astro';
import { routes, schoolAlternates, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import type { School } from '@/lib/content';

interface Props {
  locale: Locale;
  ede: School | undefined;
}

const { locale, ede } = Astro.props;
const ui = t(locale);

// Las etapas de la escuela (si el bloque "Etapas" tiene contenido).
const timeline = ede?.features.find((f) => f.type === 'timeline');
const steps = timeline && 'steps' in timeline ? timeline.steps : [];
---

<section class="ede section surface-deep" aria-labelledby="ede-title">
  <div class="container ede__grid">
    <div class="ede__media" data-reveal="scale">
      {ede?.image ? <SmartImage image={ede.image} sizes="(min-width: 64rem) 45vw, 100vw" /> : <ImagePlaceholder label="EDE" />}
      <p class="ede__quote">“{ui.home.edeQuote}”</p>
    </div>

    <div class="ede__text">
      <p class="eyebrow eyebrow--line ede__eyebrow" data-reveal>{ui.home.edeEyebrow}</p>
      <h2 id="ede-title" data-reveal style="--reveal-delay: 80ms">{ui.home.edeTitle}</h2>
      <p class="lead ede__lead" data-reveal style="--reveal-delay: 160ms">{ui.home.edeText}</p>

      {
        steps.length > 0 && (
          <div class="ede__steps" data-reveal style="--reveal-delay: 200ms">
            <h3 class="ede__steps-title">{ui.home.edeHow}</h3>
            <ol role="list">
              {steps.map((s) => (
                <li>
                  <span class="ede__step-label">{s.label}</span>
                  <span class="ede__step-title">{s.title}</span>
                </li>
              ))}
            </ol>
          </div>
        )
      }

      <div class="ede__actions" data-reveal style="--reveal-delay: 240ms">
        {
          ede && (
            <a class="btn btn--primary" href={schoolAlternates(ede.slug)[locale]} data-event="ede_home_click">
              {ui.home.edeCta} <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
          )
        }
        <a class="btn btn--outline" href={`${routes.contact[locale]}?motivo=study`} data-event="ede_home_contact_click">
          {ui.home.edeContact}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .ede__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .ede__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-9);
    }
  }

  .ede__media {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: min(34rem, 75svh);
    width: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .ede__media {
      aspect-ratio: 16 / 10;
    }
  }

  .ede__media :global(img),
  .ede__media :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ede__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(10 29 29 / 0.9), transparent 55%);
  }

  /* Frase de invitación sobre la foto. */
  .ede__quote {
    position: absolute;
    inset: auto var(--space-6) var(--space-6);
    z-index: 1;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--color-text-on-dark);
  }

  .ede__eyebrow {
    color: var(--color-river);
  }

  .ede__text h2 {
    margin-top: var(--space-4);
  }

  .ede__lead {
    margin-top: var(--space-5);
    color: var(--color-text-on-dark-muted);
  }

  .ede__steps {
    margin-top: var(--space-6);
  }

  .ede__steps-title {
    margin-bottom: var(--space-3);
    color: var(--color-river);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .ede__steps ol {
    display: grid;
    gap: var(--space-3);
  }

  .ede__steps li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-left: 4px solid var(--color-river);
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 0.06);
  }

  .ede__step-label {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1;
  }

  .ede__step-title {
    color: var(--color-text-on-dark-muted);
    font-weight: 600;
  }

  .ede__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-6);
  }
</style>
