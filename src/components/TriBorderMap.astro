---
/**
 * MAPA INTERACTIVO DE LA TRIPLE FRONTERA (Vive el Amazonas · Cómo llegar)
 * ----------------------------------------------------------------------------
 * Dibujo ilustrativo (NO exacto) de la zona: el río Amazonas, los tres países y
 * los puntos clave. Se toca un punto para ver cómo llegar:
 *   - ciudades: Leticia (Colombia), Tabatinga (Brasil), Santa Rosa (Perú)
 *   - base en la selva: Ronda · JUCUM El Puente
 *   - puertas de entrada: Bogotá (avión), Iquitos y Manaus (río)
 * Los textos salen de ui.ts (amazon.mapInfo). Las posiciones están en % del
 * dibujo (x, y); para mover un punto, cambia su x/y en `points`.
 */
import type { Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale).amazon;
const info = ui.mapInfo;

type Kind = 'city' | 'base' | 'gate';
// `side`: de qué lado va el nombre (l izquierda, r derecha, t arriba, b abajo) para que no se superpongan.
const points: { key: keyof typeof info; name: string; x: number; y: number; kind: Kind; side: 'l' | 'r' | 't' | 'b' }[] = [
  { key: 'leticia', name: 'Leticia', x: 50, y: 52, kind: 'base', side: 'l' },
  { key: 'tabatinga', name: 'Tabatinga', x: 60, y: 54, kind: 'city', side: 'r' },
  { key: 'santarosa', name: 'Santa Rosa', x: 54.5, y: 67, kind: 'city', side: 'b' },
  { key: 'ronda', name: 'Ronda · El Puente', x: 38, y: 40, kind: 'base', side: 't' },
  { key: 'bogota', name: 'Bogotá', x: 11, y: 14, kind: 'gate', side: 'r' },
  { key: 'iquitos', name: 'Iquitos', x: 9, y: 74, kind: 'gate', side: 'b' },
  { key: 'manaus', name: 'Manaus', x: 90, y: 40, kind: 'gate', side: 'l' },
];
---

<div class="tbm" data-tbm>
  <div class="tbm__stage" data-live role="group" aria-label={ui.mapTitle}>
    <svg viewBox="0 0 1000 560" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <polygon class="tbm__co" points="330,0 640,0 575,300 500,330"></polygon>
      <polygon class="tbm__br" points="640,0 1000,0 1000,560 560,560 575,300"></polygon>
      <polygon class="tbm__pe" points="0,0 330,0 500,330 575,300 560,560 0,560"></polygon>
      <path class="tbm__bed" d="M0 400C150 380 300 360 450 330C520 315 560 310 600 330C700 370 850 330 1000 290"></path>
      <path class="tbm__river" d="M0 400C150 380 300 360 450 330C520 315 560 310 600 330C700 370 850 330 1000 290"></path>
      <path class="tbm__air" d="M115 85C260 20 420 110 495 285"></path>
      <path class="tbm__walk" d="M495 295C470 290 430 270 385 230"></path>
      <text class="tbm__label" x="180" y="480" transform="rotate(-8 180 480)">PERÚ</text>
      <text class="tbm__label" x="400" y="120">COLOMBIA</text>
      <text class="tbm__label" x="780" y="500">BRASIL</text>
    </svg>

    {
      points.map((p) => (
        <button type="button" class:list={['tbm__pt', `tbm__pt--${p.kind}`, `tbm__pt--${p.side}`]} style={`left:${p.x}%;top:${p.y}%`} data-key={p.key} data-text={info[p.key]} aria-pressed="false">
          <span class="tbm__dot" aria-hidden="true"></span>
          <span class="tbm__name">{p.name}</span>
        </button>
      ))
    }
  </div>

  <p class="tbm__panel" role="status" aria-live="polite" data-tbm-panel data-default={ui.mapHint}>{ui.mapHint}</p>
</div>

<script>
  /* Elegir un punto muestra cómo llegar; volver a tocarlo lo deselecciona. */
  document.querySelectorAll<HTMLElement>('[data-tbm]').forEach((map) => {
    const pts = [...map.querySelectorAll<HTMLButtonElement>('.tbm__pt')];
    const panel = map.querySelector<HTMLElement>('[data-tbm-panel]')!;
    pts.forEach((pt) =>
      pt.addEventListener('click', () => {
        const wasOn = pt.getAttribute('aria-pressed') === 'true';
        pts.forEach((p) => p.setAttribute('aria-pressed', 'false'));
        if (wasOn) {
          panel.textContent = panel.dataset.default ?? '';
          return;
        }
        pt.setAttribute('aria-pressed', 'true');
        panel.textContent = pt.dataset.text ?? '';
      }),
    );
  });
</script>

<style>
  .tbm {
    display: grid;
    gap: var(--space-4);
  }

  .tbm__stage {
    position: relative;
    aspect-ratio: 1000 / 560;
    border: 6px solid rgb(255 255 255 / 0.12);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-night-deep);
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.4);
    container-type: inline-size;
  }

  .tbm__stage svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .tbm__co {
    fill: #1f5f61;
  }

  .tbm__br {
    fill: #17484f;
  }

  .tbm__pe {
    fill: #23663f;
  }

  .tbm__bed {
    fill: none;
    stroke: var(--color-night-deep);
    stroke-width: 34;
    stroke-linecap: round;
    opacity: 0.55;
  }

  .tbm__river {
    fill: none;
    stroke: var(--color-river);
    stroke-width: 16;
    stroke-linecap: round;
    stroke-dasharray: 60 36;
    animation: tbm-flow 6s linear infinite;
  }

  .tbm__air {
    fill: none;
    stroke: #fff;
    stroke-width: 3;
    stroke-dasharray: 3 12;
    stroke-linecap: round;
    opacity: 0.8;
    animation: tbm-flow 5s linear infinite;
  }

  .tbm__walk {
    fill: none;
    stroke: var(--color-sand);
    stroke-width: 3;
    stroke-dasharray: 2 9;
    stroke-linecap: round;
  }

  @keyframes tbm-flow {
    to {
      stroke-dashoffset: -96;
    }
  }

  .tbm__label {
    fill: rgb(255 255 255 / 0.18);
    font-family: var(--font-display);
    font-size: 90px;
    letter-spacing: 0.08em;
  }

  /* Puntos */
  .tbm__pt {
    position: absolute;
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text-on-dark);
    transform: translate(-50%, -50%);
    cursor: pointer;
  }

  .tbm__dot {
    width: clamp(0.8rem, 2.6cqi, 1.3rem);
    height: clamp(0.8rem, 2.6cqi, 1.3rem);
    border: 2px solid var(--color-night-deep);
    border-radius: 50%;
    background: var(--color-sand);
    transition: transform var(--duration) var(--ease);
  }

  .tbm__pt--base .tbm__dot {
    background: var(--color-river);
    box-shadow: 0 0 0 4px rgb(0 173 239 / 0.35);
  }

  .tbm__pt--gate .tbm__dot {
    border-radius: 3px;
    background: #fff;
    transform: rotate(45deg);
  }

  .tbm__pt:hover .tbm__dot,
  .tbm__pt:focus-visible .tbm__dot,
  .tbm__pt[aria-pressed='true'] .tbm__dot {
    background: var(--color-white);
    transform: scale(1.5);
  }

  .tbm__pt--gate:hover .tbm__dot,
  .tbm__pt--gate[aria-pressed='true'] .tbm__dot {
    transform: rotate(45deg) scale(1.4);
    background: var(--color-river);
  }

  .tbm__pt:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: -2px;
    border-radius: 0.5rem;
  }

  .tbm__name {
    position: absolute;
    padding: 1px 0.4rem;
    border-radius: 4px;
    background: rgb(10 29 29 / 0.78);
    font-size: clamp(0.6rem, 2cqi, 0.85rem);
    font-weight: 700;
    white-space: nowrap;
  }

  .tbm__pt--l .tbm__name {
    top: 50%;
    right: calc(50% + 0.8rem);
    transform: translateY(-50%);
  }

  .tbm__pt--r .tbm__name {
    top: 50%;
    left: calc(50% + 0.8rem);
    transform: translateY(-50%);
  }

  .tbm__pt--t .tbm__name {
    bottom: calc(50% + 0.8rem);
    left: 50%;
    transform: translateX(-50%);
  }

  .tbm__pt--b .tbm__name {
    top: calc(50% + 0.8rem);
    left: 50%;
    transform: translateX(-50%);
  }

  .tbm__pt[aria-pressed='true'] .tbm__name {
    background: var(--color-river);
    color: var(--color-night);
  }

  .tbm__panel {
    min-height: 3.5rem;
    padding: var(--space-3) var(--space-4);
    border-left: 4px solid var(--color-river);
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 0.06);
    color: var(--color-text-on-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    .tbm__river,
    .tbm__air {
      animation: none;
    }

    .tbm__dot {
      transition: none;
    }
  }
</style>
