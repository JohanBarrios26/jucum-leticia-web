---
/**
 * CÓMO PUEDES PARTICIPAR (final de la página de un ministerio)
 * ----------------------------------------------------------------------------
 * Dos versiones:
 *   - "interactive": tres tarjetas (venir, orar, apoyar). Al elegir una aparece
 *     una frase y un botón que lleva a la acción correcta (formulario o WhatsApp
 *     con el nombre del ministerio ya escrito). Sin JavaScript se ven las tres.
 *   - "simple": un botón principal de WhatsApp y tres enlaces directos.
 * Los textos salen de ui.ts (detail.participate*, participateKit); el nombre del
 * ministerio y el WhatsApp, del panel.
 */
import { joinPathUrl, routes, type Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { whatsappUrl } from '@/lib/content';

interface Props {
  locale: Locale;
  /** Nombre del ministerio (se incluye en el mensaje de WhatsApp). */
  name: string;
  whatsapp: string | null;
  variant?: 'interactive' | 'simple';
}

const { locale, name, whatsapp, variant = 'simple' } = Astro.props;
const ui = t(locale);
const kit = ui.participateKit;

const wa = (text: string) => (whatsapp ? whatsappUrl(whatsapp, text) : routes.contact[locale]);
const options = [
  { key: 'come', label: ui.form.interests.come, text: kit.come, href: `${routes.contact[locale]}?motivo=come`, external: false },
  { key: 'pray', label: ui.form.interests.pray, text: kit.pray, href: wa(`${ui.people.prayMessage} ${name}.`), external: Boolean(whatsapp) },
  { key: 'support', label: ui.form.interests.support, text: kit.support, href: wa(`${ui.people.supportMessage} ${name}.`), external: Boolean(whatsapp) },
] as const;
const icons: Record<string, string> = {
  come: 'M5 19a2 2 0 1 0 0-.01M19 5a2 2 0 1 0 0-.01M5 17c0-6 14-4 14-10',
  pray: 'M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z',
  support: 'M12 3v18M7 8c0-2 2-3 5-3s5 1 5 3-2 3-5 3-5 1-5 3 2 3 5 3 5-1 5-3',
};
---

<section class="section surface-dark part" aria-labelledby="part-title">
  <div class="container part__inner">
    <h2 id="part-title" data-reveal>{ui.detail.participate}</h2>
    <p class="lead part__text" data-reveal style="--reveal-delay: 80ms">
      {variant === 'interactive' ? kit.pick : ui.detail.participateText}
    </p>

    {
      variant === 'interactive' ? (
        <div class="part__box" data-part data-reveal style="--reveal-delay: 140ms">
          <div class="part__tabs" role="tablist" aria-label={kit.pick}>
            {options.map((o, i) => (
              <button type="button" role="tab" class="part__tab" id={`part-tab-${o.key}`} aria-controls={`part-panel-${o.key}`} aria-selected={i === 0 ? 'true' : 'false'} data-key={o.key}>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={icons[o.key]} /></svg>
                <span>{o.label}</span>
              </button>
            ))}
          </div>
          {options.map((o, i) => (
            <div class="part__panel" role="tabpanel" id={`part-panel-${o.key}`} aria-labelledby={`part-tab-${o.key}`} data-panel={o.key} data-active={i === 0 ? '' : undefined}>
              <p class="part__panel-text">{o.text}</p>
              <a class="btn btn--primary btn--lg" href={o.href} target={o.external ? '_blank' : undefined} rel={o.external ? 'noopener' : undefined} data-event={`participate_${o.key}_click`}>
                {o.label} <span class="btn__arrow" aria-hidden="true">→</span>
              </a>
            </div>
          ))}
        </div>
      ) : (
        <div class="part__simple" data-reveal style="--reveal-delay: 140ms">
          <a class="btn btn--primary" href={wa(`${ui.contact.whatsappMessage} (${name})`)} target={whatsapp ? '_blank' : undefined} rel={whatsapp ? 'noopener' : undefined} data-event="whatsapp_click">
            {ui.home.contactTitle} <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <ul role="list" class="part__links">
            {options.map((o) => <li><a href={o.href} target={o.external ? '_blank' : undefined} rel={o.external ? 'noopener' : undefined}>{o.label}</a></li>)}
          </ul>
        </div>
      )
    }
  </div>
</section>

<script>
  /* Tarjetas interactivas: elegir una muestra su frase y su botón. */
  document.querySelectorAll<HTMLElement>('[data-part]').forEach((box) => {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...box.querySelectorAll<HTMLElement>('[data-panel]')];
    const select = (key: string) => {
      tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.key === key)));
      panels.forEach((p) => p.toggleAttribute('data-active', p.dataset.panel === key));
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab.dataset.key!));
      tab.addEventListener('keydown', (e) => {
        const next = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : null;
        if (next === null) return;
        e.preventDefault();
        const target = tabs[(next + tabs.length) % tabs.length];
        target.focus();
        select(target.dataset.key!);
      });
    });
  });
</script>

<style>
  .part__inner {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .part__text {
    max-width: 36rem;
    color: var(--color-text-on-dark-muted);
  }

  /* ---------- Simple ---------- */
  .part__simple {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .part__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .part__links a {
    color: var(--color-river);
    font-weight: 700;
    text-underline-offset: 0.25em;
  }

  /* ---------- Interactiva ---------- */
  .part__box {
    width: min(100%, 52rem);
    display: grid;
    gap: var(--space-4);
  }

  .part__tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .part__tab {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-2);
    border: 1.5px solid rgb(255 255 255 / 0.22);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.04);
    color: var(--color-text-on-dark);
    font-weight: 700;
    cursor: pointer;
    transition:
      transform var(--duration) var(--ease),
      background var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .part__tab:hover {
    transform: translateY(-3px);
    border-color: var(--color-river);
  }

  .part__tab[aria-selected='true'] {
    border-color: var(--color-river);
    background: var(--color-river);
    color: var(--color-night);
  }

  .part__tab svg {
    width: 2rem;
    height: 2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .part__panel {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding: var(--space-5);
    border-left: 4px solid var(--color-river);
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 0.06);
  }

  .part__panel-text {
    font-size: var(--text-lg, 1.25rem);
    line-height: 1.4;
  }

  /* Con JavaScript solo se ve el panel elegido; sin él, se ven los tres. */
  :global(.js) .part__panel:not([data-active]) {
    display: none;
  }

  .part__panel[data-active] {
    animation: part-in 350ms var(--ease) both;
  }

  @keyframes part-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .part__tab,
    .part__panel[data-active] {
      transition: none;
      animation: none;
    }
  }
</style>
