---
/**
 * TARJETA DE MINISTERIO
 * ----------------------------------------------------------------------------
 * Foto de fondo, número, nombre, resumen y el motivo visual del ministerio en
 * la esquina. La usan el inicio (fila horizontal) y la página /ministerios/.
 * Toda la tarjeta es un enlace a la página del ministerio.
 */
import ImagePlaceholder from '@/components/ui/ImagePlaceholder.astro';
import Motif from '@/components/ui/Motif.astro';
import SmartImage from '@/components/ui/SmartImage.astro';
import PendingContent from '@/components/PendingContent.astro';
import { ministryAlternates, type Locale } from '@/i18n/routes';
import type { Ministry } from '@/lib/content';

interface Props {
  locale: Locale;
  ministry: Ministry;
  /** Posición en la lista (empieza en 1). */
  number: number;
  /** Ancho que ocupa la imagen en pantalla (para elegir el tamaño justo). */
  sizes?: string;
}

const { locale, ministry: m, number, sizes = '(min-width: 64rem) 30rem, 80vw' } = Astro.props;
const num = String(number).padStart(2, '0');
---

<a class="m-card" href={ministryAlternates(m.slug)[locale]} data-event="ministry_card_click">
  <div class="m-card__media">
    {m.image ? <SmartImage image={m.image} decorative sizes={sizes} widths={[480, 768, 1080]} /> : <ImagePlaceholder label={num} />}
  </div>
  {
    m.motif && (
      <div class="m-card__motif">
        <Motif name={m.motif} />
      </div>
    )
  }
  <div class="m-card__body">
    <span class="m-card__num">{num}</span>
    <h3 class="m-card__title">{m.name}</h3>
    {
      m.shortDescription ? (
        <p class="m-card__text">{m.shortDescription}</p>
      ) : (
        <p class="m-card__text">
          <PendingContent locale={locale} />
        </p>
      )
    }
    <span class="m-card__arrow" aria-hidden="true">→</span>
  </div>
</a>

<style>
  .m-card {
    position: relative;
    display: block;
    height: clamp(22rem, 58vh, 30rem);
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: var(--color-text-on-dark);
    text-decoration: none;
    isolation: isolate;
  }

  .m-card__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .m-card__media :global(img),
  .m-card__media :global(picture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease);
  }

  .m-card:hover .m-card__media :global(img) {
    transform: scale(1.06);
  }

  .m-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(10 29 29 / 0.95) 0%, rgb(10 29 29 / 0.55) 45%, rgb(10 29 29 / 0.05) 75%);
  }

  /* Motivo del ministerio en la esquina superior. */
  .m-card__motif {
    position: absolute;
    top: var(--space-5);
    left: var(--space-5);
    width: 5.5rem;
    padding: var(--space-2);
    border-radius: var(--radius);
    background: rgb(10 29 29 / 0.55);
    backdrop-filter: blur(6px);
  }

  .m-card__body {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-6);
  }

  .m-card__num {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-river);
  }

  .m-card__title {
    font-size: clamp(2rem, 1.5rem + 1.5vw, 2.75rem);
    line-height: 0.95;
  }

  .m-card__text {
    color: var(--color-text-on-dark-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
    max-width: 24rem;
  }

  /* Flecha en círculo que se llena de azul al pasar el mouse. */
  .m-card__arrow {
    position: absolute;
    top: calc(-1 * var(--space-6));
    right: var(--space-6);
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 50%;
    font-size: 1.125rem;
    transition:
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      color var(--duration) var(--ease),
      transform 400ms var(--ease);
  }

  .m-card:hover .m-card__arrow {
    background: var(--color-river);
    border-color: var(--color-river);
    color: var(--color-night);
    transform: rotate(-45deg);
  }
</style>
