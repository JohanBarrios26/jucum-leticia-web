---
/**
 * BOTÓN FLOTANTE "VOLVER ARRIBA" (esquina inferior derecha)
 * ----------------------------------------------------------------------------
 * Aparece después de bajar un buen trecho (la página es larga) y sube
 * suavemente al inicio. El texto sale de ui.ts (backToTop).
 */
import type { Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
---

<div class="fab">
  <button type="button" class="fab__btn fab__btn--top" data-back-to-top hidden aria-label={ui.backToTop} title={ui.backToTop}>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 19V6m0 0-6 6m6-6 6 6" /></svg>
  </button>
</div>

<script>
  /* "Volver arriba": se muestra al bajar más de un par de pantallas. */
  const button = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
  if (button) {
    const update = () => {
      button.hidden = window.scrollY < window.innerHeight * 1.5;
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    button.addEventListener('click', () => window.scrollTo({ top: 0 }));
  }
</script>

<style>
  .fab {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 40; /* por debajo del encabezado y del menú móvil (50) */
    display: grid;
    justify-items: center;
    gap: 0.75rem;
  }

  .fab__btn {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 0.5rem 1.25rem rgb(0 0 0 / 0.35);
    transition:
      transform var(--duration) var(--ease),
      background var(--duration) var(--ease);
  }

  .fab__btn[hidden] {
    display: none;
  }

  .fab__btn:hover {
    transform: translateY(-3px) scale(1.05);
  }

  .fab__btn svg {
    width: 1.6rem;
    height: 1.6rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Volver arriba: más discreto. */
  .fab__btn--top {
    width: 2.75rem;
    height: 2.75rem;
    background: var(--color-night-soft);
    color: var(--color-text-on-dark);
    border: 1.5px solid rgb(255 255 255 / 0.25);
  }

  .fab__btn--top svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .fab__btn {
      transition: none;
    }

    .fab__btn:hover {
      transform: none;
    }
  }

  @media print {
    .fab {
      display: none;
    }
  }
</style>
