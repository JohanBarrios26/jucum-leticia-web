---
/**
 * DECLARACIÓN DE PROPÓSITO (el corazón de JUCUM Leticia)
 * ----------------------------------------------------------------------------
 * "Trayendo el Reino de Dios, uniendo el Cuerpo de Cristo para discipular las
 * naciones." Franja compacta y llamativa que va justo debajo de la portada del
 * Inicio y de "Quiénes somos": la corona de plumas (el símbolo de JUCUM
 * Leticia) a la izquierda y la frase a la derecha, con la última parte en azul.
 * El texto se edita en el panel: Quiénes somos → Lema (se traduce al inglés y
 * al portugués en el mismo campo).
 *
 * La frase se parte sola: todo lo que va antes de "para discipular" /
 * "to disciple" queda en blanco y esa última parte, en azul.
 */
import type { Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';

interface Props {
  locale: Locale;
  motto: string;
  /** Identificador del título (evita repetir ids si se usa más de una vez en la página). */
  id?: string;
}

const { locale, motto, id = 'purpose-title' } = Astro.props;
const ui = t(locale).about;

// Antes y después de "para discipular las naciones" (o su equivalente en inglés / portugués).
const m = motto.match(/^(.*?[,;]?)\s+((?:para|to|pra)\s+(?:discipul|disciple).*)$/i);
const head = m ? m[1] : motto;
const tail = m ? m[2] : '';
---

<section class="purpose section surface-deep" aria-labelledby={id}>
  <div class="container purpose__inner">
    <div class="purpose__mark" data-reveal="scale" aria-hidden="true">
      <span class="purpose__rule"></span>
      <img class="purpose__crown" src="/brand/corona-blanco.svg" alt="" width="100" height="65" />
      <span class="purpose__rule"></span>
    </div>
    <p class="eyebrow purpose__eyebrow" data-reveal>{ui.purpose}</p>
    <h2 id={id} class="purpose__text" data-reveal style="--reveal-delay: 120ms">
      <span class="purpose__head">{head}</span>
      {tail && <span class="purpose__tail"> {tail}</span>}
    </h2>
  </div>
</section>

<style>
  /* "section" le da la ola de arriba como a las demás secciones; aquí el relleno es más corto. */
  main > .purpose.section:not(:first-child):not(.no-wave),
  .purpose.section {
    padding-block: calc(var(--wave-h) + clamp(1.25rem, 3svh, 2rem)) clamp(2.5rem, 6svh, 3.75rem);
  }

  .purpose {
    position: relative;
    background:
      radial-gradient(ellipse at 85% 0%, rgb(0 173 239 / 0.22), transparent 55%),
      radial-gradient(ellipse at 0% 100%, rgb(31 111 91 / 0.4), transparent 60%),
      var(--color-night-deep, var(--color-night));
    overflow: hidden;
  }

  /* Todo centrado: símbolo entre dos líneas, etiqueta y frase en el eje de la página. */
  .purpose__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .purpose__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
    width: min(100%, 36rem);
  }

  .purpose__rule {
    flex: 1;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgb(0 173 239 / 0.7));
  }

  .purpose__rule:last-child {
    transform: scaleX(-1);
  }

  .purpose__crown {
    width: clamp(3.25rem, 7vw, 5rem);
    height: auto;
    filter: drop-shadow(0 0 1.25rem rgb(0 173 239 / 0.5));
  }

  .purpose__eyebrow {
    color: var(--color-river);
    letter-spacing: 0.22em;
  }

  .purpose__text {
    max-width: 32ch;
    margin-inline: auto;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 0.9rem + 3.4vw, 3.6rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    text-wrap: balance;
  }

  .purpose__tail {
    color: var(--color-river);
  }
</style>
