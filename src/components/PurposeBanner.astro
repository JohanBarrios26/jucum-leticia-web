---
/**
 * DECLARACIÓN DE PROPÓSITO (el corazón de JUCUM Leticia)
 * ----------------------------------------------------------------------------
 * "Trayendo el Reino de Dios, uniendo el Cuerpo de Cristo para discipular las
 * naciones." Se muestra enorme, en tres líneas, justo debajo de la portada del
 * Inicio y de "Quiénes somos". El texto se edita en el panel:
 * Quiénes somos → Lema (se traduce al inglés y al portugués en el mismo campo).
 *
 * La frase se parte sola en líneas: primero en la coma y luego antes de
 * "para discipular" / "to disciple". La última línea va en azul.
 */
import RiverLine from '@/components/ui/RiverLine.astro';
import type { Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';

interface Props {
  locale: Locale;
  motto: string;
  /** Marca visual de esta aparición (el id evita repetir identificadores si se usa dos veces). */
  id?: string;
}

const { locale, motto, id = 'purpose-title' } = Astro.props;
const ui = t(locale).about;

// Partimos en líneas: coma → y luego el "para discipular" / "to disciple".
const [first, ...rest] = motto.split(/,\s*/);
const tail = rest.join(', ');
const m = tail.match(/^(.*?)\s+((?:para|to|pra)\s+(?:discipul|disciple).*)$/i);
const lines = [first + (rest.length ? ',' : ''), ...(m ? [m[1], m[2]] : tail ? [tail] : [])].filter(Boolean);
---

<section class="purpose surface-deep" aria-labelledby={id}>
  <div class="container purpose__inner">
    <p class="eyebrow eyebrow--line purpose__eyebrow" data-reveal>{ui.purpose}</p>
    <h2 id={id} class="purpose__text">
      {
        lines.map((line, i) => (
          <span class:list={['purpose__line', { 'purpose__line--last': i === lines.length - 1 && lines.length > 1 }]} data-reveal style={`--reveal-delay: ${i * 140}ms`}>
            {line}
          </span>
        ))
      }
    </h2>
  </div>
  <div class="container purpose__river" aria-hidden="true">
    <RiverLine tone="light" />
  </div>
</section>

<style>
  .purpose {
    position: relative;
    padding-block: clamp(4rem, 12svh, 8rem) clamp(2.5rem, 7svh, 4.5rem);
    background:
      radial-gradient(ellipse at 90% 0%, rgb(0 173 239 / 0.2), transparent 55%),
      radial-gradient(ellipse at 0% 100%, rgb(31 111 91 / 0.45), transparent 60%),
      var(--color-night-deep, var(--color-night));
    overflow: hidden;
  }

  .purpose__inner {
    display: grid;
    gap: var(--space-5);
  }

  .purpose__eyebrow {
    color: var(--color-river);
  }

  .purpose__text {
    display: grid;
    gap: 0.05em;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 0.9rem + 5.3vw, 6rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    text-wrap: balance;
  }

  .purpose__line {
    display: block;
  }

  .purpose__line--last {
    color: var(--color-river);
  }

  .purpose__river {
    margin-top: var(--space-7);
    opacity: 0.8;
  }

</style>
