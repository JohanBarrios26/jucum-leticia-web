---
/**
 * ESPACIO PARA FOTO PENDIENTE
 * ----------------------------------------------------------------------------
 * Se muestra cuando un ministerio o escuela aún no tiene foto. En lugar de un
 * hueco gris, dibuja una textura de curvas de nivel (como un mapa del
 * territorio) sobre los colores de la marca, con un número o texto grande.
 * Cuando JUCUM suba la foto desde el panel, este componente deja de usarse solo.
 */
interface Props {
  /** Texto grande de fondo, ej. "04" o las iniciales. */
  label?: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<div class:list={['placeholder', className]} aria-hidden="true">
  <svg class="placeholder__lines" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
    <!-- Curvas de nivel generadas a mano: evocan un mapa topográfico / meandros del río. -->
    <g fill="none" stroke="currentColor" stroke-width="1">
      <path d="M-20 60 C 60 20, 120 110, 200 70 S 330 20, 420 80" />
      <path d="M-20 90 C 70 50, 130 140, 210 100 S 340 50, 420 110" />
      <path d="M-20 120 C 80 80, 140 170, 220 130 S 350 80, 420 140" />
      <path d="M-20 150 C 90 110, 150 200, 230 160 S 360 110, 420 170" />
      <path d="M-20 180 C 100 140, 160 230, 240 190 S 370 140, 420 200" />
      <path d="M-20 210 C 110 170, 170 260, 250 220 S 380 170, 420 230" />
      <path d="M-20 240 C 120 200, 180 290, 260 250 S 390 200, 420 260" />
    </g>
  </svg>
  {label && <span class="placeholder__label">{label}</span>}
</div>

<style>
  .placeholder {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background:
      radial-gradient(circle at 30% 20%, rgb(0 173 239 / 0.25), transparent 55%),
      linear-gradient(160deg, var(--color-green) 0%, var(--color-night) 85%);
    color: rgb(255 255 255 / 0.12);
  }

  .placeholder__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .placeholder__label {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(5rem, 12vw, 10rem);
    line-height: 1;
    color: rgb(255 255 255 / 0.16);
  }
</style>
