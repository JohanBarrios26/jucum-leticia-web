---
/**
 * ICONOS PROPIOS DE JUCUM LETICIA
 * ----------------------------------------------------------------------------
 * Pequeño juego de iconos dibujados para el sitio, con el mismo trazo
 * (redondeado, 2 px) y temas de la región:
 *   - menu  → casa sobre pilotes (palafito), como las de las bases y comunidades.
 *   - close → cerrar (dos ramas cruzadas).
 *   - globe → idioma: un globo cuyo ecuador es el río Amazonas.
 *   - top   → volver arriba: flecha que nace del río.
 *   - boat, book, people, heart, leaf, mic, compass, drop, star, sun, cross,
 *     medical → iconos de las tarjetas de ministerios, escuelas y bases.
 *
 * Uso: <Icon name="globe" />. Toma el color del texto (currentColor) y el
 * tamaño de la clase `size` o del CSS del contenedor (1em por defecto).
 * ¿Un icono nuevo? Agrega su dibujo (viewBox 24×24) a `paths`.
 */
export type IconName =
  | 'menu'
  | 'close'
  | 'globe'
  | 'top'
  | 'boat'
  | 'book'
  | 'people'
  | 'heart'
  | 'leaf'
  | 'mic'
  | 'compass'
  | 'drop'
  | 'star'
  | 'sun'
  | 'cross'
  | 'medical';

interface Props {
  name: IconName;
  class?: string;
}

const paths: Record<IconName, string> = {
  menu: 'M2.5 10.5 12 3.5l9.5 7M5 13h14M7 13v8M17 13v8M7 17.5h10',
  close: 'M5 5l14 14M19 5 5 19',
  globe: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18ZM12 3c2.8 2.6 4 5.6 4 9s-1.2 6.4-4 9M12 3c-2.8 2.6-4 5.6-4 9s1.2 6.4 4 9M3.2 12.4c2.6-2.2 4.3 1.8 8.8 0s6.2 1.8 8.8 0',
  top: 'M12 16V4.5M6 10.5l6-6 6 6M4.5 20.5c2.4-1.8 4.2 1.4 7.5 0s5.1 1.8 7.5 0',
  boat: 'M12 3v10.5M12 4c3.2 2 5 5 5 9.5h-5M12 7.5c-2.4 1.8-3.8 3.8-3.8 6H12M3 16.5h18l-2.5 3.5h-13L3 16.5Z',
  book: 'M12 6.5C9.8 5 6.8 4.5 4 5v13c2.8-.5 5.8 0 8 1.5 2.2-1.5 5.2-2 8-1.5V5c-2.8-.5-5.8 0-8 1.5ZM12 6.5v13',
  people: 'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM3 20c0-3.5 2.5-6 6-6s6 2.5 6 6M16.5 11a2.5 2.5 0 1 0 0-5M17.5 14.3c2 .6 3.5 2.5 3.5 5.7',
  heart: 'M12 20s-8-4.8-8-10.5A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 8 2.5C20 15.2 12 20 12 20Z',
  leaf: 'M5 19c0-8 5-14 15-14 0 10-6 15-14 15M5 19c3-5 6-8 10-10',
  mic: 'M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3ZM6 11a6 6 0 0 0 12 0M12 17v4M9 21h6',
  compass: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18ZM15.5 8.5l-2 5-5 2 2-5 5-2Z',
  drop: 'M12 3.5s6 6 6 10.5a6 6 0 0 1-12 0c0-4.5 6-10.5 6-10.5Z',
  star: 'm12 3.5 2.6 5.5 6 .8-4.4 4.2 1.1 6-5.3-2.9-5.3 2.9 1.1-6L3.4 9.8l6-.8L12 3.5Z',
  sun: 'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8ZM12 2.5V5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3 7 7M17 17l1.7 1.7M5.3 18.7 7 17M17 7l1.7-1.7',
  cross: 'M12 3v18M6.5 9h11',
  medical: 'M9 3.5h6V9h5.5v6H15v5.5H9V15H3.5V9H9V3.5Z',
};

const { name, class: className } = Astro.props;
---

<svg class:list={['icon', className]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path d={paths[name]}></path>
</svg>

<style>
  .icon {
    width: 1em;
    height: 1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }
</style>
