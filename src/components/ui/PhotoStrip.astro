---
/**
 * CINTA DE FOTOS (a lo ancho de la pantalla)
 * ----------------------------------------------------------------------------
 * Una fila de fotos grandes que se desliza de lado (con el dedo, la rueda o
 * las flechas del teclado) para dar vida a la página justo después de la
 * descripción. No reemplaza la galería completa: esa sigue más abajo.
 *
 * Usa las primeras fotos de la galería de la página. Con menos de 3 no se muestra.
 */
import SmartImage from '@/components/ui/SmartImage.astro';
import type { ImageRef } from '@/lib/content';

interface Props {
  images: ImageRef[];
  /** Cuántas fotos se muestran en la cinta. */
  limit?: number;
}

const { images, limit = 8 } = Astro.props;
const shown = images.slice(0, limit);
---

{
  shown.length >= 3 && (
    <section class="strip" aria-label="Fotos" data-reveal>
      <ul role="list" class="strip__track" tabindex="0">
        {shown.map((img) => (
          <li class="strip__item">
            <SmartImage image={img} sizes="(min-width: 64rem) 40vw, 80vw" widths={[480, 768, 1080]} />
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .strip {
    padding-bottom: var(--space-section);
  }

  .strip__track {
    display: flex;
    gap: clamp(0.5rem, 1.2vw, 1rem);
    padding-inline: var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
    scrollbar-color: var(--color-river) transparent;
    padding-bottom: var(--space-3);
  }

  .strip__item {
    flex: none;
    height: clamp(13rem, min(34vw, 48svh), 26rem);
    scroll-snap-align: start;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-night);
  }

  .strip__item :global(img) {
    width: auto;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .strip__track:focus-visible {
    outline: 2px solid var(--color-river);
    outline-offset: 4px;
  }
</style>
