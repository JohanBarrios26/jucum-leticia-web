---
/**
 * CANALES DE CONTACTO DIRECTO
 * ----------------------------------------------------------------------------
 * Tarjetas grandes para WhatsApp, correo y cada teléfono. Las usan la sección
 * de contacto del inicio y la página /contacto/ (junto al formulario).
 * Los datos vienen de la configuración global (getSiteSettings).
 */
import type { Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import { whatsappUrl, type SiteSettings } from '@/lib/content';

interface Props {
  locale: Locale;
  settings: SiteSettings;
}

const { locale, settings } = Astro.props;
const ui = t(locale);
---

<ul role="list" class="contact__channels">
  {
    settings.whatsapp && (
      <li data-reveal>
        <a
          class="channel channel--primary"
          href={whatsappUrl(settings.whatsapp, ui.contact.whatsappMessage)}
          target="_blank"
          rel="noopener"
          data-event="whatsapp_click"
        >
          <span class="channel__label">{ui.contact.whatsapp}</span>
          <span class="channel__value">{ui.contact.writeWhatsapp}</span>
          <span class="channel__arrow" aria-hidden="true">→</span>
        </a>
      </li>
    )
  }
  <li data-reveal style="--reveal-delay: 80ms">
    <a class="channel" href={`mailto:${settings.email}`} data-event="email_click">
      <span class="channel__label">{ui.contact.email}</span>
      <span class="channel__value">{settings.email}</span>
      <span class="channel__arrow" aria-hidden="true">→</span>
    </a>
  </li>
  {
    settings.phones.map((phone, i) => (
      <li data-reveal style={`--reveal-delay: ${160 + i * 80}ms`}>
        <a class="channel" href={phone.href} data-event="phone_click">
          <span class="channel__label">
            {ui.contact.phone} · {phone.label}
          </span>
          <span class="channel__value">{phone.number}</span>
          <span class="channel__arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .contact__channels {
    display: grid;
    gap: var(--space-3);
  }

  /* ---------- Tarjeta de canal ---------- */
  .channel {
    position: relative;
    display: grid;
    gap: var(--space-1);
    padding: var(--space-5) var(--space-8) var(--space-5) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-white);
    color: var(--color-night);
    text-decoration: none;
    transition:
      border-color var(--duration) var(--ease),
      transform 400ms var(--ease),
      box-shadow 400ms var(--ease);
  }

  .channel:hover {
    border-color: var(--color-green);
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .channel--primary {
    background: var(--color-night);
    border-color: var(--color-night);
    color: var(--color-cloud);
  }

  .channel--primary:hover {
    border-color: var(--color-river);
  }

  .channel__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-green);
  }

  .channel--primary .channel__label {
    color: var(--color-river);
  }

  .channel__value {
    font-size: var(--text-xl);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .channel__arrow {
    position: absolute;
    top: 50%;
    right: var(--space-5);
    font-size: 1.25rem;
    transform: translateY(-50%);
    transition: transform 400ms var(--ease);
  }

  .channel:hover .channel__arrow {
    transform: translate(4px, -50%);
  }
</style>
