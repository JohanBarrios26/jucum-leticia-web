---
/**
 * GALERÍA COMPLETA CON FILTROS Y VISOR (página /galeria/)
 * ----------------------------------------------------------------------------
 * - Muestra TODAS las fotos publicables en un mosaico tipo "mampostería": cada
 *   foto conserva su forma (vertical u horizontal), sin recortes ni huecos.
 * - Los botones de arriba filtran por tema (territorio, comunidades, la
 *   Palabra…). Solo aparecen los temas que tienen fotos.
 * - Al tocar una foto se abre un visor a pantalla completa (<dialog>) que
 *   recorre solo las fotos del filtro activo: flechas, teclado (← → Esc) y
 *   deslizar el dedo en el celular.
 * - Las fotos grandes del visor se descargan solo al abrirlo.
 *
 * ¿Cambiar el orden o los temas? Se hace en el panel (Foto de la galería).
 */
import SmartImage from '@/components/ui/SmartImage.astro';
import type { Locale } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import type { GalleryItem } from '@/lib/content';
import { galleryCategories } from '@/lib/content/types';

interface Props {
  locale: Locale;
  items: GalleryItem[];
}

const { locale, items } = Astro.props;
const ui = t(locale).gallery;

/** URL grande para el visor: del CDN de Sanity o el archivo local original. */
const fullUrl = (img: GalleryItem['image']) =>
  typeof img.src === 'string' ? `${img.src}?w=2000&q=75&auto=format&fit=max` : img.src.src;

// Solo los temas que tienen fotos, en el orden definido en types.ts.
const filters = galleryCategories
  .map((key) => ({ key, label: ui.categories[key], count: items.filter((i) => i.category === key).length }))
  .filter((f) => f.count > 0);
---

<div class="gx" data-gallery-explorer>
  <div class="gx__bar">
    <div class="gx__filters" role="group" aria-label={ui.filterLabel}>
      <button type="button" class="gx__chip" data-filter="all" aria-pressed="true">
        {ui.all} <span class="gx__count">{items.length}</span>
      </button>
      {
        filters.map((f) => (
          <button type="button" class="gx__chip" data-filter={f.key} aria-pressed="false">
            {f.label} <span class="gx__count">{f.count}</span>
          </button>
        ))
      }
    </div>
    <p class="gx__status" aria-live="polite" data-status>{items.length} {ui.photos}</p>
  </div>

  <ul role="list" class="gx__grid" data-grid>
    {
      items.map((item, i) => (
        <li class="gx__item" data-category={item.category}>
          <button
            type="button"
            class="gx__button"
            data-full={fullUrl(item.image)}
            data-alt={item.image.alt}
            data-title={item.title ?? ''}
            data-tag={ui.categories[item.category]}
            aria-label={`${ui.open}: ${item.title ?? item.image.alt}`}
          >
            <SmartImage
              image={item.image}
              decorative
              sizes="(min-width: 80rem) 25vw, (min-width: 48rem) 33vw, 50vw"
              widths={[480, 768, 1080]}
              priority={i < 3}
            />
            <span class="gx__caption">
              <span class="gx__tag">{ui.categories[item.category]}</span>
              {item.title && <span class="gx__title">{item.title}</span>}
            </span>
          </button>
        </li>
      ))
    }
  </ul>

  <!-- Visor a pantalla completa -->
  <dialog class="gx__viewer" aria-label={ui.viewer} data-viewer>
    <figure class="gx__figure">
      <img alt="" data-viewer-img />
      <figcaption>
        <strong data-viewer-title></strong>
        <span data-viewer-caption></span>
      </figcaption>
    </figure>
    <button type="button" class="gx__nav gx__nav--prev" aria-label={ui.prev} data-viewer-prev>←</button>
    <button type="button" class="gx__nav gx__nav--next" aria-label={ui.next} data-viewer-next>→</button>
    <button type="button" class="gx__close" aria-label={ui.close} data-viewer-close>×</button>
    <span class="gx__index" data-viewer-count></span>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery-explorer]').forEach((root) => {
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...root.querySelectorAll<HTMLLIElement>('.gx__item')];
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const viewer = root.querySelector<HTMLDialogElement>('[data-viewer]')!;
    const img = viewer.querySelector<HTMLImageElement>('[data-viewer-img]')!;
    const titleEl = viewer.querySelector<HTMLElement>('[data-viewer-title]')!;
    const captionEl = viewer.querySelector<HTMLElement>('[data-viewer-caption]')!;
    const count = viewer.querySelector<HTMLElement>('[data-viewer-count]')!;
    const photosWord = status.textContent!.replace(/^\d+\s*/, '');

    /* ---------- Filtros ---------- */
    let visible = items;
    const applyFilter = (key: string) => {
      visible = items.filter((li) => {
        const show = key === 'all' || li.dataset.category === key;
        li.hidden = !show;
        if (show) {
          // Reinicia la animación de entrada.
          li.classList.remove('is-in');
          void li.offsetWidth;
          li.classList.add('is-in');
        }
        return show;
      });
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === key)));
      status.textContent = `${visible.length} ${photosWord}`;
    };
    chips.forEach((c) => c.addEventListener('click', () => applyFilter(c.dataset.filter ?? 'all')));

    /* ---------- Visor ---------- */
    let index = 0;
    const buttonOf = (li: HTMLLIElement) => li.querySelector<HTMLButtonElement>('button[data-full]')!;
    img.addEventListener('load', () => img.removeAttribute('data-loading'));

    const show = (i: number) => {
      index = (i + visible.length) % visible.length;
      const b = buttonOf(visible[index]);
      img.setAttribute('data-loading', '');
      img.src = b.dataset.full ?? '';
      img.alt = b.dataset.alt ?? '';
      titleEl.textContent = b.dataset.title ?? '';
      captionEl.textContent = b.dataset.alt ?? '';
      count.textContent = `${index + 1} / ${visible.length}`;
      // Precarga la siguiente para que el paso sea fluido.
      const next = buttonOf(visible[(index + 1) % visible.length]).dataset.full;
      if (next) new Image().src = next;
    };

    items.forEach((li) =>
      buttonOf(li).addEventListener('click', () => {
        show(visible.indexOf(li));
        viewer.showModal();
      }),
    );
    viewer.querySelector('[data-viewer-prev]')?.addEventListener('click', () => show(index - 1));
    viewer.querySelector('[data-viewer-next]')?.addEventListener('click', () => show(index + 1));
    viewer.querySelector('[data-viewer-close]')?.addEventListener('click', () => viewer.close());
    viewer.addEventListener('click', (e) => {
      if (e.target === viewer) viewer.close();
    });
    viewer.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    viewer.addEventListener('close', () => buttonOf(visible[index])?.focus());

    // Deslizar el dedo: izquierda = siguiente, derecha = anterior.
    let startX = 0;
    viewer.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    viewer.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );
  });
</script>

<style>
  /* ---------- Barra de filtros ---------- */
  .gx__bar {
    position: sticky;
    top: var(--header-height, 4.5rem);
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    margin-bottom: var(--space-6);
    padding-block: var(--space-3);
    background: var(--color-cloud);
    border-bottom: 1px solid var(--color-border);
  }

  .gx__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* En el celular los filtros van en una sola fila deslizable (ocupan poco) y la barra no se queda fija. */
  @media (max-width: 47.99rem) {
    .gx__bar {
      position: static;
    }

    .gx__filters {
      flex-wrap: nowrap;
      width: 100%;
      margin-inline: calc(var(--space-4) * -1);
      padding-inline: var(--space-4);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .gx__chip {
      flex: none;
    }
  }

  .gx__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    padding: 0.4rem 1rem;
    border: 1px solid var(--color-night);
    border-radius: 999px;
    background: transparent;
    color: var(--color-night);
    font-size: var(--text-sm);
    font-weight: 600;
    transition:
      background-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .gx__chip:hover {
    background: rgb(10 29 29 / 0.08);
  }

  .gx__chip[aria-pressed='true'] {
    background: var(--color-night);
    color: var(--color-cloud);
  }

  .gx__count {
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }

  .gx__status {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- Mosaico "mampostería" ---------- */
  .gx__grid {
    columns: 2;
    column-gap: clamp(0.5rem, 1.2vw, 1rem);
  }

  @media (min-width: 48rem) {
    .gx__grid {
      columns: 3;
    }
  }

  @media (min-width: 80rem) {
    .gx__grid {
      columns: 4;
    }
  }

  .gx__item {
    margin-bottom: clamp(0.5rem, 1.2vw, 1rem);
    break-inside: avoid;
  }

  .gx__item[hidden] {
    display: none;
  }

  .gx__item.is-in {
    animation: gx-in 500ms var(--ease) both;
  }

  @keyframes gx-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  .gx__button {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-night);
    cursor: zoom-in;
  }

  .gx__button :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 900ms var(--ease);
  }

  .gx__button:hover :global(img),
  .gx__button:focus-visible :global(img) {
    transform: scale(1.05);
  }

  .gx__caption {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: 0.15rem;
    padding: var(--space-8) var(--space-4) var(--space-3);
    background: linear-gradient(to top, rgb(10 29 29 / 0.85), transparent);
    color: var(--color-cloud);
    text-align: left;
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 350ms var(--ease),
      transform 350ms var(--ease);
  }

  .gx__button:hover .gx__caption,
  .gx__button:focus-visible .gx__caption {
    opacity: 1;
    transform: none;
  }

  .gx__tag {
    color: var(--color-river);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .gx__title {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.25;
  }

  /* En pantallas táctiles no hay hover: el título se ve siempre. */
  @media (hover: none) {
    .gx__caption {
      opacity: 1;
      transform: none;
    }

    .gx__tag {
      display: none;
    }
  }

  /* ---------- Visor ---------- */
  .gx__viewer {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(10 29 29 / 0.97);
    color: var(--color-cloud);
  }

  .gx__viewer::backdrop {
    background: rgb(10 29 29 / 0.85);
  }

  .gx__figure {
    display: grid;
    grid-template-rows: 1fr auto;
    place-items: center;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-8) var(--space-9) var(--space-5);
  }

  .gx__figure img {
    max-width: 100%;
    max-height: calc(100dvh - 9rem);
    object-fit: contain;
    border-radius: var(--radius-sm);
    transition: opacity 300ms var(--ease);
  }

  .gx__figure img[data-loading] {
    opacity: 0;
  }

  .gx__figure figcaption {
    display: grid;
    gap: 0.2rem;
    max-width: 48rem;
    text-align: center;
  }

  .gx__figure figcaption strong {
    font-size: var(--text-lg);
  }

  .gx__figure figcaption span {
    color: var(--color-text-on-dark-muted);
    font-size: var(--text-sm);
  }

  .gx__nav,
  .gx__close {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--color-border-on-dark);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.06);
    color: var(--color-cloud);
    font-size: 1.25rem;
    transition: background-color var(--duration) var(--ease);
  }

  .gx__nav:hover,
  .gx__close:hover {
    background: var(--color-river);
    color: var(--color-night);
  }

  .gx__nav {
    top: 50%;
    transform: translateY(-50%);
  }

  .gx__nav--prev {
    left: var(--space-4);
  }

  .gx__nav--next {
    right: var(--space-4);
  }

  .gx__close {
    top: var(--space-4);
    right: var(--space-4);
    font-size: 1.75rem;
  }

  .gx__index {
    position: absolute;
    top: var(--space-5);
    left: var(--space-5);
    color: var(--color-text-on-dark-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 40rem) {
    .gx__figure {
      padding: var(--space-8) var(--space-3) var(--space-5);
    }

    .gx__nav {
      top: auto;
      bottom: var(--space-4);
      transform: none;
    }

    .gx__nav--prev {
      left: var(--space-3);
    }

    .gx__nav--next {
      right: var(--space-3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gx__item.is-in {
      animation: none;
    }

    .gx__button :global(img) {
      transition: none;
    }
  }
</style>
