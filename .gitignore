# Compilación
dist/
# Tipos generados por Astro
.astro/

# Dependencias
node_modules/

# Logs
npm-debug.log*

# Variables de entorno (nunca subir secretos)
.env
.env.*
!.env.example

# Documentos internos del cliente (no se publican en el repositorio)
*.docx
~$*.docx

# Respaldos del contenido de Sanity (se guardan fuera de Git)
studio/seed/
studio/backups/

# Herramientas locales
.claude/
.vercel/
.wrangler/

# Sistema / editor
.DS_Store
Thumbs.db
.idea/

# Material informativo del cliente (no se publica)
Documentos Informacion/

# Audios de OBT (se suben al panel, no al repositorio)
AUDIOS OBT/

# Fotos originales del cliente (~600 MB; las usadas están subidas a Sanity)
FOTOS JUCUM/

# Servidores: fotos y descripciones con teléfonos y datos personales (nunca se suben a Git)
SERVIDORES/

# Scripts con datos de personas (se quedan solo en este equipo; la fuente real de los datos es Sanity)
scripts/privado/
