# Copia este archivo como .env para desarrollo local (el .env no se sube a Git).

# Dominio público del sitio. En Vercel/Cloudflare se detecta solo; defínelo
# cuando JUCUM tenga su dominio propio.
# SITE_URL=https://jucumleticia.org

# Mostrar las marcas "Pendiente de contenido" (true mientras el cliente revisa).
PUBLIC_SHOW_PENDING=true

# Clave pública de Web3Forms para el formulario de contacto (https://web3forms.com).
# PUBLIC_WEB3FORMS_KEY=

# ID del sitio en Umami para la analítica sin cookies (https://cloud.umami.is).
# PUBLIC_UMAMI_WEBSITE_ID=
